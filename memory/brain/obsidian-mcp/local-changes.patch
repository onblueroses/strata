diff --git a/src/vault/watch_filter.rs b/src/vault/watch_filter.rs
new file mode 100644
index 0000000..e05b6ba
--- /dev/null
+++ b/src/vault/watch_filter.rs
@@ -0,0 +1,148 @@
+//! A `notify` watcher that forwards change events only.
+//!
+//! `notify`'s inotify backend subscribes to `IN_OPEN` alongside the change
+//! masks, so on Linux every read of a vault file reaches the watcher as an
+//! [`EventKind::Access`] event. `notify-debouncer-mini` erases event kinds, and
+//! the indexer answers a debounced event by reading the file, which raises the
+//! next open event: once a note has been read (by a tool call or by the
+//! indexer itself) it is reindexed every debounce window until the process
+//! exits, and every reindex commits the Tantivy index. Dropping access events
+//! before they reach the debouncer breaks the cycle. Index state depends only
+//! on create, modify, remove and rename events, which pass through unchanged;
+//! the close-after-write event is kept because it marks a completed write.
+
+use std::path::Path;
+
+use notify::event::{AccessKind, AccessMode};
+use notify::{
+    Config, Event, EventHandler, EventKind, RecommendedWatcher, RecursiveMode, Result, Watcher,
+    WatcherKind,
+};
+use notify_debouncer_mini::Debouncer;
+
+/// Debouncer over a [`ChangeWatcher`]: the handle every vault watcher keeps alive.
+pub type ChangeDebouncer = Debouncer<ChangeWatcher>;
+
+/// [`RecommendedWatcher`] that drops read-side [`EventKind::Access`] events.
+pub struct ChangeWatcher(RecommendedWatcher);
+
+/// Whether an event can change what the index should contain.
+pub fn is_change_event(kind: &EventKind) -> bool {
+    !matches!(
+        kind,
+        EventKind::Access(AccessKind::Any)
+            | EventKind::Access(AccessKind::Read)
+            | EventKind::Access(AccessKind::Open(_))
+            | EventKind::Access(AccessKind::Close(AccessMode::Any))
+            | EventKind::Access(AccessKind::Close(AccessMode::Read))
+            | EventKind::Access(AccessKind::Close(AccessMode::Execute))
+            | EventKind::Access(AccessKind::Close(AccessMode::Other))
+            | EventKind::Access(AccessKind::Other)
+    )
+}
+
+impl Watcher for ChangeWatcher {
+    fn new<F: EventHandler>(mut event_handler: F, config: Config) -> Result<Self> {
+        let inner = RecommendedWatcher::new(
+            move |event: Result<Event>| {
+                if let Ok(event) = &event
+                    && !is_change_event(&event.kind)
+                {
+                    return;
+                }
+                event_handler.handle_event(event);
+            },
+            config,
+        )?;
+        Ok(Self(inner))
+    }
+
+    fn watch(&mut self, path: &Path, recursive_mode: RecursiveMode) -> Result<()> {
+        self.0.watch(path, recursive_mode)
+    }
+
+    fn unwatch(&mut self, path: &Path) -> Result<()> {
+        self.0.unwatch(path)
+    }
+
+    fn configure(&mut self, option: Config) -> Result<bool> {
+        self.0.configure(option)
+    }
+
+    fn kind() -> WatcherKind {
+        RecommendedWatcher::kind()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::{CreateKind, DataChange, ModifyKind, RemoveKind};
+
+    #[test]
+    fn read_side_access_events_are_not_change_events() {
+        for kind in [
+            EventKind::Access(AccessKind::Any),
+            EventKind::Access(AccessKind::Read),
+            EventKind::Access(AccessKind::Open(AccessMode::Any)),
+            EventKind::Access(AccessKind::Open(AccessMode::Read)),
+            EventKind::Access(AccessKind::Close(AccessMode::Read)),
+            EventKind::Access(AccessKind::Close(AccessMode::Any)),
+        ] {
+            assert!(!is_change_event(&kind), "{kind:?} must be dropped");
+        }
+    }
+
+    #[test]
+    fn change_events_pass() {
+        for kind in [
+            EventKind::Any,
+            EventKind::Create(CreateKind::File),
+            EventKind::Modify(ModifyKind::Data(DataChange::Any)),
+            EventKind::Modify(ModifyKind::Any),
+            EventKind::Remove(RemoveKind::File),
+            EventKind::Access(AccessKind::Close(AccessMode::Write)),
+            EventKind::Other,
+        ] {
+            assert!(is_change_event(&kind), "{kind:?} must pass");
+        }
+    }
+
+    /// Linux only: inotify is the backend that reports opens.
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn reading_a_file_raises_no_event() {
+        use std::sync::mpsc;
+        use std::time::Duration;
+
+        let dir = tempfile::tempdir().unwrap();
+        let (tx, rx) = mpsc::channel::<Result<Event>>();
+        let mut watcher = ChangeWatcher::new(
+            move |event: Result<Event>| {
+                let _ = tx.send(event);
+            },
+            Config::default(),
+        )
+        .unwrap();
+        watcher
+            .watch(dir.path(), RecursiveMode::Recursive)
+            .unwrap();
+
+        let note = dir.path().join("note.md");
+        std::fs::write(&note, "# note\n").unwrap();
+        let first = rx
+            .recv_timeout(Duration::from_secs(5))
+            .expect("a write must produce an event")
+            .unwrap();
+        assert!(is_change_event(&first.kind), "{first:?}");
+        while rx.recv_timeout(Duration::from_millis(300)).is_ok() {}
+
+        for _ in 0..5 {
+            std::fs::read_to_string(&note).unwrap();
+        }
+        match rx.recv_timeout(Duration::from_millis(700)) {
+            Ok(event) => panic!("a read must not produce an event, got {event:?}"),
+            Err(_) => {}
+        }
+    }
+}

diff --git a/src/http_auth.rs b/src/http_auth.rs
new file mode 100644
index 0000000..c3eeb0c
--- /dev/null
+++ b/src/http_auth.rs
@@ -0,0 +1,171 @@
+//! Bearer-token gate for the HTTP transport.
+//!
+//! Upstream serves `/mcp` to anyone who can reach the port. On a shared host that
+//! includes every local user, so with `OBSIDIAN_HTTP_TOKENS_FILE` set every HTTP
+//! request must carry `Authorization: Bearer <token>` for one of the tokens in that
+//! file (one per line, `#` comments and blank lines ignored). A set but unreadable or
+//! empty file is a startup error, never an open server. Tokens are never logged.
+
+use std::path::Path;
+use std::sync::Arc;
+
+use axum::http::{HeaderMap, StatusCode, header};
+use axum::response::{IntoResponse, Response};
+use zeroize::Zeroizing;
+
+pub const TOKENS_FILE_ENV: &str = "OBSIDIAN_HTTP_TOKENS_FILE";
+
+/// Tokens shorter than this are refused at load: a guessable token is no gate.
+const MIN_TOKEN_LEN: usize = 24;
+
+#[derive(Clone)]
+pub struct HttpAuth {
+    tokens: Arc<Vec<Zeroizing<Vec<u8>>>>,
+}
+
+impl HttpAuth {
+    pub fn from_tokens_text(text: &str) -> Result<Self, String> {
+        let mut tokens = Vec::new();
+        for (i, line) in text.lines().enumerate() {
+            let t = line.trim();
+            if t.is_empty() || t.starts_with('#') {
+                continue;
+            }
+            if t.len() < MIN_TOKEN_LEN || !t.bytes().all(|b| b.is_ascii_graphic()) {
+                return Err(format!(
+                    "token on line {} is shorter than {MIN_TOKEN_LEN} characters or not printable ASCII",
+                    i + 1
+                ));
+            }
+            tokens.push(Zeroizing::new(t.as_bytes().to_vec()));
+        }
+        if tokens.is_empty() {
+            return Err("no tokens".into());
+        }
+        Ok(Self {
+            tokens: Arc::new(tokens),
+        })
+    }
+
+    pub fn from_file(path: &Path) -> Result<Self, String> {
+        let text = Zeroizing::new(
+            std::fs::read_to_string(path)
+                .map_err(|e| format!("{TOKENS_FILE_ENV} {}: {e}", path.display()))?,
+        );
+        Self::from_tokens_text(&text)
+            .map_err(|e| format!("{TOKENS_FILE_ENV} {}: {e}", path.display()))
+    }
+
+    /// `None` when the variable is unset (open server, upstream behaviour);
+    /// `Some(Err)` when it is set but unusable, which callers must treat as fatal.
+    pub fn from_env() -> Option<Result<Self, String>> {
+        let raw = std::env::var_os(TOKENS_FILE_ENV)?;
+        if raw.is_empty() {
+            return Some(Err(format!("{TOKENS_FILE_ENV} is set but empty")));
+        }
+        Some(Self::from_file(Path::new(&raw)))
+    }
+
+    pub fn token_count(&self) -> usize {
+        self.tokens.len()
+    }
+
+    pub fn authorized(&self, headers: &HeaderMap) -> bool {
+        let Some(presented) = headers
+            .get(header::AUTHORIZATION)
+            .and_then(|v| v.as_bytes().strip_prefix(b"Bearer "))
+        else {
+            return false;
+        };
+        // Check every token so the time taken does not say which one was close.
+        self.tokens
+            .iter()
+            .fold(false, |hit, t| ct_eq(t, presented) | hit)
+    }
+}
+
+fn ct_eq(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
+
+pub async fn require_bearer(
+    axum::extract::State(auth): axum::extract::State<HttpAuth>,
+    request: axum::extract::Request,
+    next: axum::middleware::Next,
+) -> Response {
+    if auth.authorized(request.headers()) {
+        return next.run(request).await;
+    }
+    tracing::warn!(path = %request.uri().path(), "rejected HTTP request without a valid bearer token");
+    (
+        StatusCode::UNAUTHORIZED,
+        [(header::WWW_AUTHENTICATE, "Bearer")],
+        "unauthorized\n",
+    )
+        .into_response()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use axum::{Router, middleware, routing::get};
+
+    const T1: &str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    const T2: &str = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+
+    fn hdr(v: &str) -> HeaderMap {
+        let mut h = HeaderMap::new();
+        h.insert(header::AUTHORIZATION, v.parse().unwrap());
+        h
+    }
+
+    #[test]
+    fn parses_tokens_and_skips_comments() {
+        let a = HttpAuth::from_tokens_text(&format!("# nginx\n{T1}\n\n  {T2}  \n")).unwrap();
+        assert_eq!(a.token_count(), 2);
+    }
+
+    #[test]
+    fn refuses_empty_short_and_missing() {
+        assert!(HttpAuth::from_tokens_text("# only a comment\n\n").is_err());
+        assert!(HttpAuth::from_tokens_text("short\n").is_err());
+        assert!(HttpAuth::from_file(Path::new("/nonexistent/tokens")).is_err());
+    }
+
+    #[test]
+    fn checks_the_bearer() {
+        let a = HttpAuth::from_tokens_text(&format!("{T1}\n{T2}\n")).unwrap();
+        assert!(a.authorized(&hdr(&format!("Bearer {T1}"))));
+        assert!(a.authorized(&hdr(&format!("Bearer {T2}"))));
+        assert!(!a.authorized(&HeaderMap::new()));
+        assert!(!a.authorized(&hdr(T1)));
+        assert!(!a.authorized(&hdr(&format!("Basic {T1}"))));
+        assert!(!a.authorized(&hdr(&format!("Bearer {T1}x"))));
+        assert!(!a.authorized(&hdr(&format!("Bearer {}", &T1[1..]))));
+        assert!(!a.authorized(&hdr("Bearer ")));
+    }
+
+    #[tokio::test]
+    async fn middleware_returns_401_without_token_and_passes_with_it() {
+        let auth = HttpAuth::from_tokens_text(T1).unwrap();
+        let app = Router::new()
+            .route("/mcp", get(|| async { "ok" }))
+            .layer(middleware::from_fn_with_state(auth, require_bearer));
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+
+        let client = reqwest::Client::new();
+        let url = format!("http://{addr}/mcp");
+        let none = client.get(&url).send().await.unwrap();
+        assert_eq!(none.status().as_u16(), 401);
+        let wrong = client.get(&url).bearer_auth(T2).send().await.unwrap();
+        assert_eq!(wrong.status().as_u16(), 401);
+        let good = client.get(&url).bearer_auth(T1).send().await.unwrap();
+        assert_eq!(good.status().as_u16(), 200);
+        assert_eq!(good.text().await.unwrap(), "ok");
+    }
+}

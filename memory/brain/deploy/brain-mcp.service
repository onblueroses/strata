[Unit]
Description=Shared vault MCP server
After=network.target

[Service]
User=@BRAIN_USER@
Environment=OBSIDIAN_VAULT_PATH=@BRAIN_VAULT@
# Server-enforced allow-list. Deletion is deliberately absent.
Environment=OBSIDIAN_TOOLS=note_read,note_read_many,vault_list,search_text,search_regex,search_metadata,note_inspect,wikilinks,vault_info,note_create,note_write,note_patch,note_insert,note_move,frontmatter
Environment=OBSIDIAN_TRANSPORT=http
Environment=OBSIDIAN_HTTP_PORT=9127
Environment=OBSIDIAN_MCP_DATA=@BRAIN_MCP_DATA@
ExecStart=@BRAIN_BIN_DIR@/obsidian-mcp --http @BRAIN_VAULT@
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@BRAIN_VAULT@
BindPaths=@BRAIN_MCP_DATA@
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

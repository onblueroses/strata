{
  "description": "Codex operating hooks: OptMem wake and post-compaction orientation. Load the issue queue explicitly (brain-linear pickup codex) when picking up work.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 $HOME/.codex/hooks/optmem_start.py",
            "statusMessage": "Loading OptMem wake context",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "python3 $HOME/.codex/hooks/continuity.py",
            "statusMessage": "Restoring pre-compaction orientation",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ]
  }
}

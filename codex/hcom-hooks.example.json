{
  "description": "Optional hcom local-collaboration hooks. Merge only when hcom is installed.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "hcom codex-posttooluse",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "hcom codex-pretooluse",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "hcom codex-sessionstart",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "hcom codex-stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "hcom codex-userpromptsubmit",
            "type": "command"
          }
        ]
      }
    ]
  }
}

{
  "_timeouts": "Hook timeouts are sample values in seconds; set your own.",
  "description": "Codex OptMem wake and compaction continuity. Approve native hook trust after install.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"__STRATA_ROOT__/codex/hooks/optmem_start.py\"",
            "statusMessage": "Loading OptMem wake context",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "python3 \"__STRATA_ROOT__/codex/hooks/continuity.py\"",
            "statusMessage": "Restoring pre-compaction orientation",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ]
  }
}

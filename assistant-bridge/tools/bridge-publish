def copy_checked(vault: Path, rel: str, destination: Path, expected_size: int) -> None:
    """Copy through no-follow directory descriptors to close path-swap escapes."""
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | nofollow
    try:
        with contextlib.ExitStack() as stack:
            current_fd = os.open(vault, directory_flags)
            stack.callback(os.close, current_fd)
            parts = rel.split("/")
            for component in parts[:-1]:
                current_fd = os.open(component, directory_flags, dir_fd=current_fd)
                stack.callback(os.close, current_fd)
            fd = os.open(
                parts[-1],
                os.O_RDONLY | nofollow | getattr(os, "O_NONBLOCK", 0),
                dir_fd=current_fd,
            )
            stack.callback(os.close, fd)
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size != expected_size:
                raise BridgeError("source-changed", f"source changed during read: {shown_path(rel)}")
            destination.parent.mkdir(parents=True, exist_ok=True)
            digest = hashlib.sha256()
            with os.fdopen(fd, "rb", closefd=False) as incoming, destination.open("wb") as outgoing:
                while chunk := incoming.read(1024 * 1024):
                    digest.update(chunk)
                    outgoing.write(chunk)
            os.chmod(destination, stat.S_IMODE(info.st_mode))
            if destination.stat().st_size != expected_size or sha256_file(destination) != digest.hexdigest():
                raise BridgeError("staging-verify", f"staged copy verification failed: {shown_path(rel)}")
    except BridgeError:
        raise
    except OSError as exc:
        raise BridgeError("source-unreadable", f"approved file is unreadable: {shown_path(rel)}") from exc


FILTERED_CATEGORIES = frozenset({"denied-path", "denied-name", "denied-extension", "outside-allowed-root"})


def build_staging(policy, vault: Path, staging: Path) -> tuple[list[tuple[str, str]], list[str], int]:
    violations: list[tuple[str, str]] = []
    oversized: list[str] = []
    total = 0
    for rel in iter_allowed_candidates(vault, policy.allowed_roots):
        decision = policy.evaluate(vault, rel)
        if not decision.allowed:
            if decision.category == "oversized":
                oversized.append(rel)
            elif decision.category in FILTERED_CATEGORIES:
                violations.append((rel, decision.category))
            else:
                # Special files, escapes and unreadable sources are integrity failures, not filters.
                raise BridgeError(decision.category, f"{decision.category}: {decision.detail}: {shown_path(rel)}")
            continue
        total += decision.size
        if total > policy.max_total_bytes:
            raise BridgeError("total-size", "approved files exceed the policy total-size limit")
        destination = staging.joinpath(*rel.split("/"))
        copy_checked(vault, rel, destination, decision.size)
    return violations, oversized, total



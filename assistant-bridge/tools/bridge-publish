    parser.add_argument("--worktree", default=env_default("BRIDGE_WORKTREE", "/srv/assistant-bridge"))
    parser.add_argument("--remote-url", default=env_default("BRIDGE_REMOTE_URL"), required=env_default("BRIDGE_REMOTE_URL") is None)

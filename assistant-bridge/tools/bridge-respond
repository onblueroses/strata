# outage (an expired login, a provider incident) heals without an operator.
RETRY_COOLDOWN = timedelta(minutes=30)
# Step C skips text signed by a configured agent name followed by at most three
# qualifier words ("claude routine", "codex cloud", "claude/operator").
DEFAULT_OTHER_AGENT_SIGNERS = "claude,codex,kimi,deepseek,automation,fable"
LINEAR_TEAM_KEY_RE = re.compile(r"[A-Z][A-Z0-9]{1,9}")
MAX_API_BYTES = 8 * 1024 * 1024
MAX_API_PAGES = 100
LINEAR_TIMEOUT = 30
# A Linear outage (HTTP 5xx, 429, a timeout, or its rate limit) fails the run only once
# it has lasted this many runs in a row, so a blip neither pages the owner nor stops the
# other steps.
LINEAR_SOFT_FAILURE_LIMIT = 3
MODEL_FAILURE_LIMIT = 3
# Linear rate-limits with HTTP 400 and the error code RATELIMITED in the body, not 429
# (linear.app/developers/rate-limiting); only this much of an error body is read.
LINEAR_ERROR_BYTES = 64 * 1024
# Codex's output is never journaled; only the tail of its --json event stream is read,
# to tell a lost login from any other exit. The patterns are Codex's own login failures
# (codex-cli 0.155.1: "unexpected status 401 Unauthorized", "Your access token could not
# be refreshed. Please log out and sign in again."; 0.156.1 without a login: "unexpected
# status 401 Unauthorized: Missing bearer or basic authentication in header"). A refresh
# token counts only in a terminal form: "Failed to refresh token: <network cause>" is an
# outage that heals, and paging the owner at once for it would be a false alarm.
CODEX_EVENTS_TAIL = 64 * 1024
CODEX_AUTH_RE = re.compile(
    r"\b401\b|\bunauthori[sz]ed\b|\bnot (?:logged|signed) in\b"
    r"|could not be refreshed|\blog out and sign in\b|\bsign(?:ing)? in again\b"
    r"|\brefresh token (?:was |has been )?(?:revoked|expired|already (?:been )?used)\b"
    r"|refresh_token_(?:reused|expired|invalidated)\b",
    re.IGNORECASE,
)
# A mirror issue the responder opens starts with this template (see step B).
WITHHELD_TITLE = "content withheld"
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
LOGIN_RE = re.compile(
    r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$|^[A-Za-z0-9_.-]+\[bot\]$"
)



class ModelFailure(Exception):
    def __init__(
        self,
        category: str,
        *,
        exit_code: int | None = None,
        exit_class: str | None = None,
    ):
        super().__init__(category)
        self.category = category
        self.exit_code = exit_code
        self.exit_class = exit_class

    def describe(self) -> str:
        """The category for the journal; a Codex exit adds its code and class."""
        if self.exit_code is None:
            return self.category
        return f"{self.category} code={self.exit_code} class={self.exit_class}"


def codex_exit_class(events: bytes) -> str:
    """"auth" when Codex's own failure report names a lost login, else "other".

    Codex runs with --json. The model's reasoning and messages, which the untrusted
    packet can steer, travel inside item events; Codex's own failure is its turn.failed
    event, or its error events when no turn.failed came. Only those are read. stderr is
    not: its logs name the login code even when only the network failed.
    """
    failed: list[str] = []
    errors: list[str] = []
    for line in events[-CODEX_EVENTS_TAIL:].splitlines():
        try:
            event = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if not isinstance(event, dict):
            continue
        error = event.get("error")
        if event.get("type") == "turn.failed" and isinstance(error, dict):
            if isinstance(error.get("message"), str):
                failed.append(error["message"])
        elif event.get("type") == "error" and isinstance(event.get("message"), str):
            errors.append(event["message"])
    messages = failed or errors
    return "auth" if any(CODEX_AUTH_RE.search(message) for message in messages) else "other"



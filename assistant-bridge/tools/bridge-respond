def validate_url(value: str, label: str) -> str:
    parsed = urlparse.urlsplit(value)
    loopback = parsed.hostname in {"127.0.0.1", "localhost", "::1"}
    if (
        parsed.scheme not in {"https", "http"}
        or (parsed.scheme == "http" and not loopback)
        or not parsed.netloc
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
    ):
        raise BridgeError("configuration-invalid", f"{label} URL is invalid")
    return value.rstrip("/")


def validate_configuration(args: argparse.Namespace) -> None:
    if not isinstance(args.repo, str) or not REPO_RE.fullmatch(args.repo):
        raise BridgeError("configuration-invalid", "configured repository is invalid")
    if not isinstance(args.author, str) or not LOGIN_RE.fullmatch(args.author):
        raise BridgeError("configuration-invalid", "configured author is invalid")
    if args.codex_timeout <= 0 or args.codex_timeout > 3600:
        raise BridgeError("configuration-invalid", "Codex timeout is invalid")
    if args.max_codex_runs_per_hour <= 0:
        raise BridgeError("configuration-invalid", "Codex budget is invalid")
    if not LINEAR_TEAM_KEY_RE.fullmatch(args.linear_team_key):
        raise BridgeError("configuration-invalid", "Linear team key is invalid")
    compile_other_agent_signature_re(args.other_agent_signers)
    if not args.token_file:
        raise BridgeError("configuration-invalid", "GitHub token file is required")
    validate_url(args.api_url, "GitHub API")
    validate_url(args.linear_url, "Linear API")


def compile_other_agent_signature_re(value: str) -> re.Pattern[str]:
    names = [name.strip().casefold() for name in value.split(",")]
    if not names or len(names) > 32 or any(
        re.fullmatch(r"[a-z][a-z0-9_-]{0,39}", name) is None for name in names
    ):
        raise BridgeError("configuration-invalid", "other agent signer list is invalid")
    bases = "|".join(re.escape(name) for name in names)
    return re.compile(rf"(?:{bases})(?:[ /-][a-z0-9]+){{0,3}}")


def ascii_secret(
    path: Path, label: str, *, additional_owner_uids: set[int] | None = None
) -> str:
    raw = read_secret_file(
        path, label, additional_owner_uids=additional_owner_uids or set()
    )
    try:
        value = raw.decode("ascii")
    except UnicodeDecodeError as exc:
        raise BridgeError("secret-invalid", f"{label} file is invalid") from exc
    if (
        not value
        or len(value) > 2048
        or any(character.isspace() or ord(character) < 33 for character in value)
    ):
        raise BridgeError("secret-invalid", f"{label} file is invalid")
    return value


def parse_time(value: object) -> datetime:
    if not isinstance(value, str):
        return datetime(1970, 1, 1, tzinfo=timezone.utc)
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            return datetime(1970, 1, 1, tzinfo=timezone.utc)
        # "0001-01-01T00:00:00+01:00" parses but has no UTC equivalent.
        return parsed.astimezone(timezone.utc)
    except (ValueError, OverflowError):
        return datetime(1970, 1, 1, tzinfo=timezone.utc)


def timestamp_after(value: object, cursor: str) -> bool:
    return parse_time(value) > parse_time(cursor)


def cursor_now() -> str:
    return (
        datetime.now(timezone.utc)
        .isoformat(timespec="microseconds")
        .replace("+00:00", "Z")
    )


def stable_hash(value: object) -> str:
    encoded = json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


class NoRedirect(urlrequest.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class GitHubAPI:
    def __init__(self, api_url: str, repo: str, token: str):
        self.base = validate_url(api_url, "GitHub API")
        self.repo = repo
        self.token = token
        self.opener = urlrequest.build_opener(NoRedirect())

    def request(
        self,
        method: str,
        path: str,
        payload: dict[str, object] | None = None,
    ) -> object:
        data = None
        headers = {
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {self.token}",
            "User-Agent": "assistant-bridge-respond/1",
            "X-GitHub-Api-Version": "2022-11-28",
        }
        if payload is not None:
            data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urlrequest.Request(
            f"{self.base}{path}", data=data, headers=headers, method=method
        )
        try:
            with self.opener.open(request, timeout=30) as response:
                raw = response.read(MAX_API_BYTES + 1)
        except urlerror.HTTPError as exc:
            raise ApiError(
                "github-api", f"GitHub API {method} failed with HTTP {exc.code}"
            ) from exc
        except (urlerror.URLError, TimeoutError, OSError) as exc:
            raise ApiError("github-api", "GitHub API request failed") from exc
        if len(raw) > MAX_API_BYTES:
            raise ApiError("github-api", "GitHub API response is too large")
        if not raw:
            return None
        try:
            return json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ApiError("github-api", "GitHub API returned invalid JSON") from exc

    def paginated(
        self, path: str, query: dict[str, str] | None = None
    ) -> list[object]:
        items: list[object] = []
        for page in range(1, MAX_API_PAGES + 1):
            parameters = dict(query or {})
            parameters.update({"per_page": "100", "page": str(page)})
            separator = "&" if "?" in path else "?"
            document = self.request(
                "GET", f"{path}{separator}{urlparse.urlencode(parameters)}"
            )
            if not isinstance(document, list):
                raise ApiError("github-api", "GitHub API returned an invalid list")
            items.extend(document)
            if len(document) < 100:
                return items
        raise ApiError("github-api", "GitHub API pagination limit exceeded")

    def issues_since(self, since: str) -> list[object]:
        return self.paginated(
            f"/repos/{self.repo}/issues",
            {"state": "open", "since": since, "sort": "updated", "direction": "asc"},
        )

    def comments_since(self, since: str) -> list[object]:
        return self.paginated(
            f"/repos/{self.repo}/issues/comments",
            {"since": since, "sort": "created", "direction": "asc"},
        )

    def issues_by(self, creator: str) -> list[object]:
        return self.paginated(
            f"/repos/{self.repo}/issues",
            {"state": "all", "creator": creator, "sort": "created", "direction": "asc"},
        )

    def user(self) -> object:
        return self.request("GET", "/user")

    def issue(self, number: int) -> object:
        return self.request("GET", f"/repos/{self.repo}/issues/{number}")

    def issue_comments(self, number: int) -> list[object]:
        return self.paginated(f"/repos/{self.repo}/issues/{number}/comments")

    def post_comment(self, number: int, body: str) -> dict[str, object]:
        document = self.request(
            "POST", f"/repos/{self.repo}/issues/{number}/comments", {"body": body}
        )
        if not isinstance(document, dict) or type(document.get("id")) is not int:
            raise ApiError("github-api", "GitHub comment response is invalid")
        return document

    def create_issue(self, title: str, body: str) -> dict[str, object]:
        document = self.request(
            "POST", f"/repos/{self.repo}/issues", {"title": title, "body": body}
        )
        if not isinstance(document, dict) or type(document.get("number")) is not int:
            raise ApiError("github-api", "GitHub issue response is invalid")
        return document

    def close_issue(self, number: int) -> None:
        document = self.request(
            "PATCH", f"/repos/{self.repo}/issues/{number}", {"state": "closed"}
        )
        if not isinstance(document, dict):
            raise ApiError("github-api", "GitHub close response is invalid")



# Render @...@ values from deploy/env.example before installing.
[Unit]
Description=Apply the messaging assistant's inbox pull requests into the vault
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@BRIDGE_VAULT_USER@
TimeoutStartSec=15m
WorkingDirectory=@BRIDGE_WORKTREE@
EnvironmentFile=@BRIDGE_CONFIG_DIR@/bridge.env
Environment=BRIDGE_TOKEN_FILE=@BRIDGE_APPLY_TOKEN_FILE@
ExecStart=@BRIDGE_EXEC_DIR@/bridge-apply

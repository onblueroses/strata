# Example values. Replace the GitHub owner, assistant login, users, and site paths.
# Install the rendered bridge.env root-owned outside the worktree. Keep secrets in separate
# singly linked mode-0600 files; this file contains paths only.
BRIDGE_CONFIG_DIR=/etc/assistant-bridge
BRIDGE_EXEC_DIR=/usr/local/lib/assistant-bridge
BRIDGE_VAULT_USER=bridge-vault
BRIDGE_VAULT=/srv/brain-vault
BRIDGE_WORKTREE=/srv/assistant-bridge
BRIDGE_REMOTE_URL=git@github-bridge:owner/assistant-bridge.git
BRIDGE_POLICY=/srv/assistant-bridge/bridge-policy.toml
BRIDGE_GITLEAKS=/usr/local/bin/gitleaks
BRIDGE_GITLEAKS_CONFIG=/etc/assistant-bridge/gitleaks.toml
BRIDGE_AUDIT_LOG=/var/lib/assistant-bridge/audit.jsonl
BRIDGE_STATE_FILE=/var/lib/assistant-bridge/import-state
BRIDGE_BACKUP_DIR=/var/lib/assistant-bridge/backups
BRIDGE_GIT_NAME=assistant-bridge-publish
BRIDGE_GIT_EMAIL=bridge-publish@invalid
BRIDGE_LOCK_FILE=/var/lib/assistant-bridge/bridge.lock
BRIDGE_PUSH_STATE=/var/lib/assistant-bridge/publish-pending.json
BRIDGE_VISIBILITY_ATTESTATION=/etc/assistant-bridge/repository.json
BRIDGE_JOB_STATUS_DIR=/var/lib/assistant-bridge
BRIDGE_PAUSE_DIR=/etc/assistant-bridge/paused
BRIDGE_CHECK_STATE=/var/lib/assistant-bridge/check
BRIDGE_CHECK_JOBS="publish apply respond"
BRIDGE_REPO=owner/assistant-bridge
BRIDGE_AUTHOR=assistant-account
BRIDGE_APPLY_TOKEN_FILE=/etc/assistant-bridge/apply.token
BRIDGE_RESPOND_TOKEN_FILE=/etc/assistant-bridge/github.token
BRIDGE_LINEAR_KEY_FILE=/etc/assistant-bridge/linear.token
BRIDGE_LINEAR_TEAM_KEY=ABC
# Base names of signed agent comments to skip. Replace or extend for this issue tracker.
BRIDGE_OTHER_AGENT_SIGNERS=claude,codex,kimi,deepseek,automation,fable
BRIDGE_RESPOND_HOME=/var/lib/assistant-respond
BRIDGE_RESPOND_USER=assistant-respond
BRIDGE_RESPOND_STATE=/var/lib/assistant-respond/state/state.json
BRIDGE_RESPOND_LOCK=/var/lib/assistant-respond/state/respond.lock
BRIDGE_RESPOND_SCRATCH=/var/lib/assistant-respond/runs
BRIDGE_RESPOND_AUDIT_LOG=/var/lib/assistant-respond/state/audit.jsonl
BRIDGE_RESPOND_STATUS=/var/lib/assistant-respond/state/status.json
BRIDGE_CODEX_MODEL=gpt-5.6-sol
BRIDGE_RULES_DIR=/usr/local/lib/assistant-bridge/rules
BRIDGE_AUTO_APPLY_ROOTS="5 Inbox"
BRIDGE_ACK_FOR_CLAUDE=0

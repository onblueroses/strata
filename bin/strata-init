#!/usr/bin/env bash
# strata-init — first-run bootstrap for a strata install.
#
# Usage: strata-init [--non-interactive] [--enable-bypass-permissions] [INSTALL_DIR]
#   INSTALL_DIR defaults to the parent of this script (resolves $STRATA_HOME).
#
# Idempotent: re-running refreshes managed copies with recoverable backups,
# upgrades the venv, and seeds only missing workspace or privacy files.

set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: strata-init [--non-interactive] [--enable-bypass-permissions] [INSTALL_DIR]' \
    '  INSTALL_DIR defaults to the parent of this script (resolves $STRATA_HOME).'
}

NON_INTERACTIVE=false
case "${STRATA_NON_INTERACTIVE:-}" in
  1|true|yes) NON_INTERACTIVE=true ;;
esac
ENABLE_BYPASS_PERMISSIONS=false
INSTALL_DIR=""

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --non-interactive)
      NON_INTERACTIVE=true
      ;;
    --enable-bypass-permissions)
      ENABLE_BYPASS_PERMISSIONS=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      if [[ "$#" -gt 1 ]]; then
        echo "strata-init: expected at most one install directory" >&2
        exit 1
      fi
      [[ "$#" -eq 0 ]] || INSTALL_DIR="$1"
      break
      ;;
    -*)
      echo "strata-init: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$INSTALL_DIR" ]]; then
        echo "strata-init: expected at most one install directory" >&2
        exit 1
      fi
      INSTALL_DIR="$1"
      ;;
  esac
  shift
done

# Resolve install root.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STRATA_HOME="${INSTALL_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
[[ -d "$STRATA_HOME" ]] || { echo "strata-init: install dir missing: $STRATA_HOME" >&2; exit 1; }
export STRATA_HOME
echo "=== strata-init ==="
echo "Install:  $STRATA_HOME"

required_missing=false
for dependency in jq python3 git; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    echo "strata-init: required dependency missing: $dependency (run bin/strata-doctor)" >&2
    required_missing=true
  fi
done

# pydantic-ai 2.16, selected by bin/lib/requirements.txt, declares Python >=3.10.
# Keep this check before next_backup_path and every installer write below.
PYTHON_MIN_MAJOR=3
PYTHON_MIN_MINOR=10
if command -v python3 >/dev/null 2>&1; then
  if PYTHON_VERSION="$(python3 -c '
import sys

minimum = (int(sys.argv[1]), int(sys.argv[2]))
print(".".join(str(part) for part in sys.version_info[:3]))
raise SystemExit(sys.version_info[:2] < minimum)
' "$PYTHON_MIN_MAJOR" "$PYTHON_MIN_MINOR" 2>/dev/null)"; then
    :
  else
    echo "strata-init: Python $PYTHON_MIN_MAJOR.$PYTHON_MIN_MINOR or newer is required (found ${PYTHON_VERSION:-unknown}); run bin/strata-doctor" >&2
    required_missing=true
  fi
fi
$required_missing && exit 1

next_backup_path() {
  local target="$1" stamp candidate collision
  stamp="$(date +%Y%m%d%H%M%S)"
  candidate="$target.pre-strata.$stamp"
  collision=1  # First suffix is used only after the unsuffixed timestamp collides.
  while [[ -e "$candidate" || -L "$candidate" ]]; do
    candidate="$target.pre-strata.$stamp.$collision"
    collision=$((collision + 1))
  done
  printf '%s\n' "$candidate"
}

install_copy() {
  local source="$1" target="$2" label="$3" backup
  mkdir -p "$(dirname "$target")"

  if [[ ! -e "$target" && ! -L "$target" ]]; then
    cp "$source" "$target"
    echo "  installed $label: $target"
    return 0
  fi

  if [[ ! -L "$target" && -f "$target" ]] && cmp -s "$source" "$target"; then
    echo "  unchanged $label: $target"
    return 0
  fi

  backup="$(next_backup_path "$target")"
  mv "$target" "$backup"
  if cp "$source" "$target"; then
    echo "  refreshed $label: $target"
    echo "  backed up previous $label: $backup"
  else
    mv "$backup" "$target"
    echo "strata-init: could not refresh $label; restored $target" >&2
    return 1
  fi
}

confirm_yes() {
  local prompt="$1" reply=""
  printf '%s [y/N] ' "$prompt"
  if { read -r reply </dev/tty; } 2>/dev/null; then
    printf '\n'
  else
    printf '\n'
    return 1
  fi
  [[ "$reply" == "y" || "$reply" == "Y" ]]
}

escape_double_quoted() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//\$/\\\$}"
  value="${value//\`/\\\`}"
  printf '%s' "$value"
}

write_posix_block() {
  local escaped_home
  escaped_home="$(escape_double_quoted "$STRATA_HOME")"
  printf '%s\n' "$BEGIN_MARK"
  printf 'export STRATA_HOME="%s"\n' "$escaped_home"
  printf '%s\n' 'export KB_DIR="${KB_DIR:-$STRATA_HOME/workspace}"'
  printf '%s\n' 'export STATE_DIR="${STATE_DIR:-$KB_DIR/state}"'
  printf '%s\n' 'export SPECS_DIR="${SPECS_DIR:-$STATE_DIR/specs}"'
  printf '%s\n' 'export PATH="$STRATA_HOME/bin:$PATH"'
  printf '%s\n' "$END_MARK"
}

write_fish_block() {
  local escaped_home
  escaped_home="$(escape_double_quoted "$STRATA_HOME")"
  printf '%s\n' "$BEGIN_MARK"
  printf 'set -gx STRATA_HOME "%s"\n' "$escaped_home"
  printf '%s\n' 'set -q KB_DIR; or set -gx KB_DIR "$STRATA_HOME/workspace"'
  printf '%s\n' 'set -q STATE_DIR; or set -gx STATE_DIR "$KB_DIR/state"'
  printf '%s\n' 'set -q SPECS_DIR; or set -gx SPECS_DIR "$STATE_DIR/specs"'
  printf '%s\n' 'contains -- "$STRATA_HOME/bin" $PATH; or set -gx PATH "$STRATA_HOME/bin" $PATH'
  printf '%s\n' "$END_MARK"
}

install_rc_block() {
  local rc_file="$1" shell_name="$2" block_file candidate marker_report backup
  mkdir -p "$(dirname "$rc_file")"
  block_file="$(mktemp "$HOME/.strata-rc-block.XXXXXX")"
  if [[ "$shell_name" == "fish" ]]; then
    write_fish_block >"$block_file"
  else
    write_posix_block >"$block_file"
  fi

  if [[ ! -e "$rc_file" && ! -L "$rc_file" ]]; then
    printf '\n' >"$rc_file"
    while IFS= read -r line || [[ -n "$line" ]]; do
      printf '%s\n' "$line"
    done <"$block_file" >>"$rc_file"
    echo "  installed shell block: $rc_file"
  else
    if [[ ! -f "$rc_file" ]]; then
      rm -f -- "$block_file"
      echo "strata-init: refusing to modify shell config $rc_file because it is not a regular file" >&2
      return 1
    fi

    candidate="$(mktemp "$HOME/.strata-rc-candidate.XXXXXX")"
    if ! cp -p "$rc_file" "$candidate"; then
      rm -f -- "$block_file" "$candidate"
      echo "strata-init: could not copy shell config for validation: $rc_file" >&2
      return 1
    fi

    if marker_report="$(python3 - "$candidate" "$block_file" "$BEGIN_MARK" "$END_MARK" <<'PY'
from pathlib import Path
import sys

target = Path(sys.argv[1])
block = Path(sys.argv[2]).read_text().splitlines()
begin, end = sys.argv[3], sys.argv[4]
lines = target.read_text(errors="surrogateescape").splitlines()
begin_indices = [index for index, line in enumerate(lines) if line == begin]
end_indices = [index for index, line in enumerate(lines) if line == end]

if not begin_indices and not end_indices:
    updated = lines + [""] + block
elif (
    len(begin_indices) == 1
    and len(end_indices) == 1
    and begin_indices[0] < end_indices[0]
):
    updated = (
        lines[: begin_indices[0]]
        + block
        + lines[end_indices[0] + 1 :]
    )
else:
    report = (
        f"found {len(begin_indices)} begin marker(s) "
        f"and {len(end_indices)} end marker(s)"
    )
    if (
        len(begin_indices) == 1
        and len(end_indices) == 1
        and begin_indices[0] >= end_indices[0]
    ):
        report += "; markers are out of order"
    print(report)
    raise SystemExit(2)

target.write_text(
    "\n".join(updated) + "\n",
    errors="surrogateescape",
)
PY
    )"; then
      install_copy "$candidate" "$rc_file" "shell config"
      rm -f -- "$candidate"
    else
      backup="$(next_backup_path "$rc_file")"
      if cp -p "$candidate" "$backup"; then
        echo "strata-init: refusing to modify $rc_file: $marker_report; expected no markers or exactly one ordered pair" >&2
        echo "strata-init: left $rc_file unchanged and backed it up to $backup" >&2
      else
        echo "strata-init: refusing to modify $rc_file: $marker_report; backup creation also failed" >&2
      fi
      rm -f -- "$block_file" "$candidate"
      return 1
    fi
  fi
  rm -f -- "$block_file"
}

# === Shell rc detection ===

rc_for_shell() {
  case "$(basename "${SHELL:-bash}")" in
    zsh)  echo "$HOME/.zshrc" ;;
    bash) echo "$HOME/.bashrc" ;;
    fish) echo "$HOME/.config/fish/config.fish" ;;
    *)    echo "" ;;
  esac
}

RC_FILE="$(rc_for_shell)"
BEGIN_MARK="# >>> strata env >>>"
END_MARK="# <<< strata env <<<"
RC_INSTALLED=false
SHELL_NAME="$(basename "${SHELL:-bash}")"

if [[ -n "$RC_FILE" ]]; then
  echo "Shell:    ${SHELL:-bash} → $RC_FILE"
  if $NON_INTERACTIVE; then
    echo "  non-interactive mode: installing the guarded shell block"
    install_rc_block "$RC_FILE" "$SHELL_NAME"
    RC_INSTALLED=true
  elif confirm_yes "Append or refresh the guarded strata environment block in $RC_FILE?"; then
    install_rc_block "$RC_FILE" "$SHELL_NAME"
    RC_INSTALLED=true
  else
    if [[ "$SHELL_NAME" == "fish" ]]; then
      MANUAL_ENV="$STRATA_HOME/strata.fish"
      MANUAL_CANDIDATE="$(mktemp "$HOME/.strata-env.XXXXXX")"
      write_fish_block >"$MANUAL_CANDIDATE"
    else
      MANUAL_ENV="$STRATA_HOME/strata.env"
      MANUAL_CANDIDATE="$(mktemp "$HOME/.strata-env.XXXXXX")"
      write_posix_block >"$MANUAL_CANDIDATE"
    fi
    install_copy "$MANUAL_CANDIDATE" "$MANUAL_ENV" "manual shell fragment"
    rm -f -- "$MANUAL_CANDIDATE"
    echo "  shell rc left unchanged; source $MANUAL_ENV manually"
  fi
else
  MANUAL_ENV="$STRATA_HOME/strata.env"
  MANUAL_CANDIDATE="$(mktemp "$HOME/.strata-env.XXXXXX")"
  write_posix_block >"$MANUAL_CANDIDATE"
  install_copy "$MANUAL_CANDIDATE" "$MANUAL_ENV" "manual shell fragment"
  rm -f -- "$MANUAL_CANDIDATE"
  echo "Shell:    unknown (\$SHELL=${SHELL:-}); source $MANUAL_ENV manually"
fi

# === Privacy denylist ===

PRIVATE_TOKENS="$STRATA_HOME/config/private-tokens.txt"
PRIVATE_TOKENS_EXAMPLE="$STRATA_HOME/config/private-tokens.example.txt"
echo ""
echo "=== Privacy denylist ==="
if [[ -e "$PRIVATE_TOKENS" || -L "$PRIVATE_TOKENS" ]]; then
  echo "  unchanged existing denylist: $PRIVATE_TOKENS"
else
  cp "$PRIVATE_TOKENS_EXAMPLE" "$PRIVATE_TOKENS"
  echo "  seeded denylist from config/private-tokens.example.txt"
fi
echo "  edit $PRIVATE_TOKENS and add one private token per line"

# === Claude Code settings install ===
# Claude Code reads $HOME/.claude/settings.json, not the install root.

CLAUDE_SETTINGS="$HOME/.claude/settings.json"
STRATA_SETTINGS="$STRATA_HOME/settings.json"
STRATA_HOME_SED="$(printf '%s\n' "$STRATA_HOME" | sed 's/[\\&|]/\\&/g')"
mkdir -p "$HOME/.claude"
RENDERED_SETTINGS="$(mktemp "$HOME/.claude/.strata-settings-rendered.XXXXXX")"
DESIRED_SETTINGS="$(mktemp "$HOME/.claude/.strata-settings-desired.XXXXXX")"
sed "s|\\\$STRATA_HOME|$STRATA_HOME_SED|g" "$STRATA_SETTINGS" >"$RENDERED_SETTINGS"

echo ""
echo "=== Claude Code settings ==="
if ! $ENABLE_BYPASS_PERMISSIONS && ! $NON_INTERACTIVE; then
  if confirm_yes "Enable bypassPermissions? Yes disables Claude Code permission prompts globally. No keeps read-oriented tools and exact read-only Git checks preapproved; other shell commands, file changes, and MCP tools require approval."; then
    ENABLE_BYPASS_PERMISSIONS=true
  fi
fi

if $ENABLE_BYPASS_PERMISSIONS; then
  jq '.permissions.defaultMode = "bypassPermissions"' \
    "$RENDERED_SETTINGS" >"$DESIRED_SETTINGS"
  echo "  enabled bypassPermissions; Claude Code permission prompts are disabled globally for this user"
else
  if [[ -f "$CLAUDE_SETTINGS" ]] && jq -e '.permissions | has("defaultMode")' \
      "$CLAUDE_SETTINGS" >/dev/null 2>&1; then
    EXISTING_MODE="$(jq -c '.permissions.defaultMode' "$CLAUDE_SETTINGS")"
    jq --argjson existing_mode "$EXISTING_MODE" \
      '.permissions.defaultMode = $existing_mode' \
      "$RENDERED_SETTINGS" >"$DESIRED_SETTINGS"
    echo "  preserved the existing permission defaultMode"
  else
    cp "$RENDERED_SETTINGS" "$DESIRED_SETTINGS"
    echo "  left permission defaultMode unset"
  fi
  echo "  bypassPermissions was not enabled; other shell commands, file changes, and MCP tools require approval unless covered by an existing defaultMode"
  echo "  rerun with --enable-bypass-permissions to opt in to prompt-free tool use"
fi
install_copy "$DESIRED_SETTINGS" "$CLAUDE_SETTINGS" "Claude settings"
rm -f -- "$RENDERED_SETTINGS" "$DESIRED_SETTINGS"

# === Claude Code surfaces (CLAUDE.md + skills/commands/agents/hooks/reference) ===
# Discovery directories are symlinked. The copied CLAUDE.md refreshes on rerun.

echo ""
echo "=== Claude Code surfaces ==="
mkdir -p "$HOME/.claude"

link_or_backup() {
  local target="$1" source="$2"
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    echo "  unchanged link $target -> $source"
    return 0
  fi
  if [[ -e "$target" || -L "$target" ]]; then
    local backup
    backup="$(next_backup_path "$target")"
    mv "$target" "$backup"
    echo "  backed up $target -> $backup"
  fi
  ln -s "$source" "$target"
  echo "  linked $target -> $source"
}

# CLAUDE.md is copied so users can extend it; reruns preserve those extensions
# in a timestamped backup before refreshing the shipped doctrine.
install_copy "$STRATA_HOME/CLAUDE.md" "$HOME/.claude/CLAUDE.md" "CLAUDE.md"

# Symlink the discovery directories.
for dir in skills commands agents hooks reference; do
  link_or_backup "$HOME/.claude/$dir" "$STRATA_HOME/$dir"
done

# === Agent venv ===

VENV="$STRATA_HOME/.local/agent-venv"
REQ="$STRATA_HOME/bin/lib/requirements.txt"

echo ""
echo "=== Agent venv ==="
if [[ -x "$VENV/bin/python" ]]; then
  echo "Venv:     $VENV (existing — upgrading)"
else
  echo "Venv:     $VENV (creating)"
  python3 -m venv "$VENV"
fi
"$VENV/bin/python" -m pip install --quiet --upgrade pip
"$VENV/bin/python" -m pip install --quiet -r "$REQ"
echo "Dependencies installed from $REQ"

# === Workspace seed ===

echo ""
echo "=== Workspace seed ==="
WS="$STRATA_HOME/workspace"
mkdir -p "$WS"/{state/specs,state/handoffs}

seed_readme() {
  local path="$1" body="$2"
  [[ -f "$path" ]] && return 0
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$body" > "$path"
  echo "  seeded $path"
}

seed_readme "$WS/state/specs/README.md" "# state/specs/

Active implementation specs, one file per feature. Specs survive context
compaction; the Status field controls visibility during recovery."

seed_readme "$WS/state/handoffs/README.md" "# state/handoffs/

Session-to-session handoff notes. Read the relevant handoff before resuming work."

# === Done ===

echo ""
echo "=== Next steps ==="
echo "1. Add private identifiers to $STRATA_HOME/config/private-tokens.txt."
echo "2. Fill in $STRATA_HOME/config/model-map.toml (replace <PICK_...> placeholders)."
echo "3. Set API keys in $STRATA_HOME/.local/.env (one KEY=VALUE per line) or export"
echo "   them: ANTHROPIC_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY, GEMINI_API_KEY."
if $RC_INSTALLED; then
  echo "4. Open a new shell (or run \`source $RC_FILE\`), then verify:"
else
  echo "4. Source the manual shell fragment shown above, then verify:"
fi
echo "     strong --help && fast --help && grader --help && breadth --help"
echo "5. Run $STRATA_HOME/bin/strata-doctor to re-check dependencies and configuration."
echo "6. Start a Claude Code session in any project; strata auto-loads from \$STRATA_HOME."
echo ""
echo "=== Done ==="

{
  "_timeouts": "Hook timeouts are sample values in seconds; set your own.",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__STRATA_ROOT__/claude/hooks/notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__STRATA_ROOT__/claude/hooks/optmem-wake.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"__STRATA_ROOT__/claude/hooks/optmem-core.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"__STRATA_ROOT__/claude/hooks/session-post-compaction-restore.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"__STRATA_ROOT__/claude/hooks/session-inject-time.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__STRATA_ROOT__/claude/hooks/session-inject-time.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

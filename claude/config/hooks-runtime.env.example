# Source from a private startup profile before launching Claude Code.
# Match these locations to the services installed for this OS user.
OPTMEM_MEMO="$HOME/.local/bin/memo"
MEMORY_DIR="$HOME/.optmem/memory"
# The operator's notes tree (live) and its read-only archive; agents and hooks read these.
NOTES_ROOT="<notes-tree>"
NOTES_ARCHIVE="<notes-archive>"
# Sealed decisions read by the agents before proposing a direction.
DECISIONS_DIR="<notes-tree>/decisions"
# Session briefs written by /context-save, read first by the compaction-restore hooks.
# BRIEF_DIR="$NOTES_ROOT/briefs"  (the default; set it to where your briefs live)
# STATE_DIR="$NOTES_ARCHIVE/state"  (older saves, read only)
# Optional: the harness's per-hook SessionStart injection limit in characters, from its docs.
# Unset, the OptMem hooks skip the oversize warning.
# OPTMEM_INJECTION_BUDGET="<characters>"
# Optional: characters of a session save inlined after compaction (sample default 7000).
# COMPACTION_SAVE_CHARS="<characters>"
# Optional: minutes before the clock hook repeats the time (sample default 30).
# CLOCK_STALE_MIN="<minutes>"
# Optional: bound on the telemetry write after a compaction restore (sample default 1s).
# TELEMETRY_TIMEOUT="<duration>"

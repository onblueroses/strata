# Source from a private startup profile before launching Claude Code.
# Match these locations to the services installed for this OS user.
OPTMEM_MEMO="$HOME/.local/bin/memo"
MEMORY_DIR="$HOME/.optmem/memory"
CLAUDE_SESSION_STATE_DIR="$HOME/.local/state/claude-sessions"
CLAUDE_DAILY_DIR="$HOME/.local/share/claude-daily"
LIFE_SYNC_REPO="$HOME/workspace-notes"
UNPUSHED_WORK_ROOT="$HOME/Work"
ISSUE_TRACKER_CLI="$HOME/.local/bin/brain-linear"
PRIVACY_TOKENS_FILE="$HOME/.config/privacy/private-tokens.txt"
PRIVATE_PUSH_DESTINATIONS_FILE="$HOME/.config/privacy/private-push-destinations.txt"
PRIVATE_PUSH_NETWORKS_FILE="$HOME/.config/privacy/private-push-networks.txt"
export PRIVATE_REPO_MATCH="private-repo"
export PUBLIC_REPO_MATCH="public-repo"
export PRIVACY_SCANNER="<checkout>/claude/hooks/lib/privacy-scan.py"
GATE_TELEMETRY_EMITTER="$HOME/.local/bin/telemetry-emit"
ESTATE_BACKUP_ENV="$HOME/.config/estate-backup/env"

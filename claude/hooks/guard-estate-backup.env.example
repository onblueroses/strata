# Copy into a private mode-600 file and set ESTATE_BACKUP_ENV to its path.
RESTIC_REPOSITORY='<restic-repository>'
RCLONE_PROGRAM='<rclone-executable>'
RCLONE_ARGS='<rclone-arguments>'
RCLONE_ARGS_PRUNE='<rclone-prune-arguments>'
STORAGEBOX_JUMP='<ssh-jump-alias>'
STORAGEBOX_HOST='<backup-host>'
STORAGEBOX_PORT='<backup-port>'
OPTMEM_STORE="$HOME/.optmem"
ESTATE_PATHS=("$HOME/.optmem" "$HOME/.codex/config.toml")
CODE_PATHS=("$HOME/Work" "$HOME/Documents")

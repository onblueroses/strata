#!/usr/bin/env python3
"""quote-check - open the page behind every quoted finding of a research report and look for the quote.

  quote-check REPORT.md [REPORT.md ...]     summary per file on stderr, one TSV row per quote on stdout

A row is a markdown table line that carries a quoted passage and a URL. Verdicts:
  exact          the whole quote is on the fetched page (after normalising quotes, dashes, emphasis
                 marks and whitespace)
  partial        an eight-word run of it is: the quote was trimmed or stitched
  not-found      the page loaded and the quote is not in its text (some pages render with JavaScript)
  page-not-read  the page did not load
A found quote confirms the wording, not the report's reading of it. Fetches with curl; PDFs go
through pdftotext; GitHub file links are read raw. No browser. Reports are read as data only.
Ruling of 2026-11-10: free research fleets always run with this check.
"""
import concurrent.futures as cf, html, os, re, subprocess, sys
from pathlib import Path


def norm(text):
    text = html.unescape(re.sub(r"<[^>]+>", " ", text))
    for a, b in (("’", "'"), ("‘", "'"), ("“", '"'), ("”", '"'), ("–", "-"), ("—", "-"), ("‑", "-"), (" ", " ")):
        text = text.replace(a, b)
    return re.sub(r"\s+", " ", re.sub(r"[^\w' ]+", " ", text)).lower().strip()


BARE = re.compile(r"^(?:[a-z0-9-]+\.)+[a-z]{2,}(?:/\S*)?$", re.I)


def rows(path):
    found = []
    for line in path.read_text(errors="replace").splitlines():
        if not line.startswith("|"):
            continue
        quotes = re.findall(r"[“\"]([^”\"]{12,})[”\"]", line)
        urls = re.findall(r"https?://[^\s|)\]>]+", line)
        if not urls:  # a cell that is only a bare address, as free models often write it
            urls = ["https://" + c for c in (cell.strip().strip("`<>") for cell in line.split("|")) if BARE.match(c)]
        if quotes and urls:
            found.append((max(quotes, key=len), urls[0]))
    return found


# Optional settings (see delegation/wrappers/runtime.env.example); unset means no limit and
# Python's default worker count.
FETCH_SECONDS = os.environ.get("QUOTE_CHECK_FETCH_SECONDS", "")
WORKERS = int(os.environ["QUOTE_CHECK_WORKERS"]) if os.environ.get("QUOTE_CHECK_WORKERS") else None


def fetch(url):
    target = url
    if "github.com" in url and "/blob/" in url:
        target = url.replace("github.com/", "raw.githubusercontent.com/").replace("/blob/", "/")
    try:
        limit = ["--max-time", FETCH_SECONDS] if FETCH_SECONDS else []
        body = subprocess.run(["curl", "-sL", *limit, "-A", "Mozilla/5.0 (research quote check)", target],
                              capture_output=True).stdout
        if body[:4] == b"%PDF":
            body = subprocess.run(["pdftotext", "-", "-"], input=body, capture_output=True).stdout
        return url, norm(body.decode("utf-8", "replace"))
    except (OSError, subprocess.SubprocessError):
        return url, ""


def verdict(quote, page):
    wanted = norm(quote.replace("**", ""))
    words = wanted.split()
    if len(page) < 300:
        return "page-not-read"
    if wanted in page:
        return "exact"
    if len(words) >= 8 and any(" ".join(words[i:i + 8]) in page for i in range(0, len(words) - 7, 3)):
        return "partial"
    return "not-found"


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 0 if argv else 1
    files = [Path(a) for a in argv]
    missing = [str(f) for f in files if not f.is_file()]
    if missing:
        print("quote-check: no such file: " + ", ".join(missing), file=sys.stderr)
        return 1
    parsed = {f: rows(f) for f in files}
    urls = sorted({url for found in parsed.values() for _, url in found})
    with cf.ThreadPoolExecutor(WORKERS) as pool:
        pages = dict(pool.map(fetch, urls))
    for f, found in parsed.items():
        tally = {"exact": 0, "partial": 0, "not-found": 0, "page-not-read": 0}
        for quote, url in found:
            v = verdict(quote, pages.get(url, ""))
            tally[v] += 1
            print(f"{f}\t{v}\t{url}\t{quote[:120]}")
        print(f"{f}: {len(found)} quoted rows; exact {tally['exact']}, partial {tally['partial']}, "
              f"not found {tally['not-found']}, page not read {tally['page-not-read']}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

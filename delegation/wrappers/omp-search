#!/usr/bin/env bash
# omp-search - run one web-research prompt on a free OpenRouter model through omp, in free-silo.
# Free endpoints log prompts for provider training: public topics and public people only; never
# data we hold (CRM rows, our addresses, vault text). The silo makes that structural: the model
# sees an empty jail, not this machine (a ticket).
#
#   omp-search "prompt"               web_search + read + write, auto-approved
#   omp-search --oneshot "prompt"     web_search + read only
#   omp-search --cwd DIR "prompt"     files the run writes are copied to DIR afterwards
#   omp-search --in FILE "prompt"     copy a reviewed, public input into the jail (repeatable)
#   omp-search --model SLUG "prompt"  another OpenRouter model (see DEFAULT_MODEL)
#   omp-search --max-time 10m "prompt"
#   omp-search --search tavily "prompt"  search backend (default searxng = Codex-hosted search
#                                      through codex-search-bridge; duckduckgo and tavily also work)
#   echo "prompt" | omp-search
#
# OpenRouter :free quota is per key, shared by every :free model: 20 req/min, 1000 req/day.
# Default inkling-small:free after the 2026-09-16 runs. General non-search work: omp-inkling.
set -uo pipefail

DEFAULT_MODEL="thinkingmachines/inkling-small:free"
MODEL="$DEFAULT_MODEL" TOOLS="web_search,read,write" MAX_TIME="15m" SEARCH="searxng"
SILO=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd) SILO+=(--out "$2"); shift 2 ;;
    --in) SILO+=(--in "$2"); shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --max-time) MAX_TIME="$2"; shift 2 ;;
    --search) SEARCH="$2"; shift 2 ;;
    --oneshot) TOOLS="web_search,read"; shift ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \?//' >&2; exit 1 ;;
    *) break ;;
  esac
done
PROMPT="$*"
[[ -z "$PROMPT" && ! -t 0 ]] && PROMPT="$(cat)"
[[ -z "$PROMPT" ]] && { echo "omp-search: no prompt" >&2; exit 1; }

JAIL="$(mktemp -d "${FREE_SILO_ROOT:-$HOME/.local/share/free-silo}/jails/search.XXXXXX")" || exit 2
printf 'providers:\n  webSearchOrder:\n    - %s\n' "$SEARCH" > "$JAIL/.free-silo-search.yml"
exec free-silo --jail "$JAIL" "${SILO[@]}" -- omp --model "openrouter/$MODEL" -p --auto-approve \
  --tools "$TOOLS" --max-time "$MAX_TIME" --no-rules --no-skills \
  --config "$JAIL/.free-silo-search.yml" "$PROMPT" < /dev/null

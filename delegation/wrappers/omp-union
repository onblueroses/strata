#!/usr/bin/env bash
# omp-union - run one prompt on an explicitly chosen free OpenRouter model in free-silo.
# Unbranded, prompt-logging endpoint: no data we hold in, no unattributed output out.
#
#   omp-union "prompt"             agentic, tool calls auto-approved, confined to the jail
#   omp-union --oneshot "prompt"   read-only tools
#   omp-union --in FILE "prompt"   copy a reviewed, public input into the jail (repeatable)
#   omp-union --cwd DIR "prompt"   files the run writes are copied to DIR afterwards
#   echo "prompt" | omp-union
set -uo pipefail

MODEL="${OMP_UNION_MODEL:-}"
ARGS=( -p --auto-approve --no-rules --no-skills ) SILO=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd) SILO+=(--out "$2"); shift 2 ;;
    --in) SILO+=(--in "$2"); shift 2 ;;
    --model) MODEL="${2:-}"; shift 2 ;;
    --oneshot) ARGS+=( --tools read,glob,grep,web_search ); shift ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \?//' >&2; exit 1 ;;
    *) break ;;
  esac
done
[[ -n "$MODEL" ]] || { echo "omp-union: select a current model with --model or OMP_UNION_MODEL" >&2; exit 1; }
[[ "$MODEL" == openrouter/* ]] || MODEL="openrouter/$MODEL"
ARGS=( --model "$MODEL" "${ARGS[@]}" )
PROMPT="$*"
[[ -z "$PROMPT" && ! -t 0 ]] && PROMPT="$(cat)"
[[ -z "$PROMPT" ]] && { echo "omp-union: no prompt" >&2; exit 1; }

exec free-silo "${SILO[@]}" -- omp "${ARGS[@]}" "$PROMPT" < /dev/null

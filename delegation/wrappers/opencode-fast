#!/usr/bin/env bash
# opencode-fast: groundwork worker on OpenCode Go (ruling of 2026-11-12).
# Default model opencode-go/deepseek-v4.1-flash: the operator chose it for groundwork, meaning
# not-super-complicated implementation, edits, extraction and bulk chores.
# Harder work stays on codex-strong / codex-fast.
#
# Free models are refused because free endpoints may train on requests. Inputs: no secrets.
# Tool permissions follow the user's own opencode configuration.
set -euo pipefail
# vps installs opencode under ~/.opencode/bin, which non-interactive ssh shells lack.
[[ -x "$HOME/.opencode/bin/opencode" ]] && PATH="$HOME/.opencode/bin:$PATH"

usage() {
  cat <<'EOF'
opencode-fast: opencode run on OpenCode Go (default: opencode-go/deepseek-v4.1-flash)

  opencode-fast [flags] "task"
  echo "task" | opencode-fast [flags]

flags:
  --model SLUG     Go model, with or without the opencode-go/ prefix (env OPENCODE_FAST_MODEL)
  --cwd DIR        run in DIR (default: the current directory); edits land there
  --file PATH      attach a file (repeatable)
  --worktree NAME  run in a new git worktree of the current repo
  --resume ID      continue an opencode session
  --json           print opencode's JSON event stream
  --timeout SEC    kill the run after SEC seconds (default: none)
  --thinking       show thinking blocks

Every run prints its model, directory and session title to stderr. Sessions are archived, so they
stay out of the interactive session list.
EOF
}

model="${OPENCODE_FAST_MODEL:-deepseek-v4.1-flash}"
cwd="" timeout="" args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --model) model="$2"; shift 2 ;;
    --cwd) cwd="$2"; shift 2 ;;
    --file) args+=(--file "$2"); shift 2 ;;
    --worktree) args+=(--worktree "$2"); shift 2 ;;
    --resume) args+=(--session "$2"); shift 2 ;;
    --json) args+=(--format json); shift ;;
    --thinking) args+=(--thinking); shift ;;
    --timeout) timeout="$2"; shift 2 ;;
    --) shift; break ;;
    -*) echo "opencode-fast: unknown flag $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

prompt="$*"
if [[ -z "$prompt" && ! -t 0 ]]; then prompt="$(cat)"; fi
[[ -n "$prompt" ]] || { usage >&2; exit 2; }
[[ "$model" == */* ]] || model="opencode-go/$model"
[[ "$model" == opencode-go/* ]] || { echo "opencode-fast: only opencode-go/* models (got $model)" >&2; exit 2; }
case "$model" in *free*) echo "opencode-fast: free models train on requests; refused" >&2; exit 2 ;; esac
[[ -n "$cwd" ]] && cd "$cwd"

title="opencode-fast $(date +%Y%m%dT%H%M%S)-$$"
echo "opencode-fast: model $model, cwd $PWD, title '$title'" >&2
cmd=(opencode run --model "$model" --archived --title "$title" "${args[@]}" "$prompt")
if [[ -n "$timeout" ]]; then
  timeout "$timeout" "${cmd[@]}" < /dev/null
else
  "${cmd[@]}" < /dev/null
fi

# Put actual credentials in a private mode-600 file and point DELEGATE_ENV_FILE to it.
# Never source this placeholder file for a dispatch.
DELEGATE_ENV_FILE="$HOME/.config/delegate/.env"
OPTMEM_MEMO="$HOME/.local/bin/memo"
export DELEGATE_TELEMETRY_EMITTER="$HOME/.local/bin/telemetry-emit"
# Must name an existing private notes tree for free-silo --verify's isolation probe.
export FREE_SILO_PRIVATE_NOTES_ROOT="<private-notes-root>"
DELEGATE_PYTHON="$HOME/.local/share/delegate-venv/bin/python"
DELEGATE_DS_AGENT="<checkout>/delegation/wrappers/ds_agent.py"
DSH_DRIVER_ROOT="$HOME/.local/share/dsh-driver"
DSH_AGENT_OVERLAY="<private-config>/dsh-agent.yml"
DSH_REPO="<checkout-of-deepseek-harness>"
FREE_SILO_ROOT="$HOME/.local/share/free-silo"
CODEX_SEARCH_BRIDGE_TOKEN_FILE="$HOME/.config/codex-search-bridge/token"
# OPENROUTER_API_KEY=<secret>
# TAVILY_API_KEY=<secret>
# DEEPSEEK_API_KEY=<secret>
# CODEX_UNION_MODEL=<current-free-openrouter-model>
# OMP_UNION_MODEL=<current-free-openrouter-model>

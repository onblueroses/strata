# Put actual credentials in a private mode-600 file and point DELEGATE_ENV_FILE to it.
# Never source this placeholder file for a dispatch.
DELEGATE_ENV_FILE="$HOME/.config/delegate/.env"
OPTMEM_MEMO="$HOME/.local/bin/memo"
export DELEGATE_TELEMETRY_EMITTER="$HOME/.local/bin/telemetry-emit"
DELEGATE_PYTHON="$HOME/.local/share/delegate-venv/bin/python"
DELEGATE_DS_AGENT="<checkout>/delegation/wrappers/ds_agent.py"
DSH_DRIVER_ROOT="$HOME/.local/share/dsh-driver"
DSH_AGENT_DRIVER_ROOT="$HOME/.local/share/dsh-driver-<pinned-release>"
DSH_AGENT_OVERLAY="<private-config>/dsh-agent.yml"
DSH_REPO="<checkout-of-deepseek-harness>"
# Base URLs of the local LiteLLM bridges that ensure-provider-bridge waits for.
export DEEPSEEK_BRIDGE_URL="http://127.0.0.1:<deepseek-bridge-port>"
export OPENROUTER_BRIDGE_URL="http://127.0.0.1:<openrouter-bridge-port>"
# Optional: how often codex-hcom.py reads session state, in seconds (sample value 1).
# export CODEX_HCOM_POLL_SECONDS="<seconds>"
# Optional for quote-check: a per-page fetch limit in seconds and a worker count; unset means none.
# export QUOTE_CHECK_FETCH_SECONDS="<seconds>"
# export QUOTE_CHECK_WORKERS="<count>"
# OPENROUTER_API_KEY=<secret>
# DEEPSEEK_API_KEY=<secret>
# OPENCODE_API_KEY=<secret>

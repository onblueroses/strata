#!/usr/bin/env bash
set -Eeuo pipefail

readonly repo="${DSH_REPO:-$HOME/.local/share/deepseek-harness}"
# 3080 is DeepSeek Harness's documented default Web UI port.
readonly url="http://127.0.0.1:3080"
readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/deepseek-harness"
readonly log_file="$state_dir/web.log"

is_running() {
  curl --fail --silent --max-time 1 "$url/" \
    | grep --quiet '<title>DeepSeek Harness</title>'
}

open_ui() {
  nohup xdg-open "$url" >/dev/null 2>&1 &
  printf 'DeepSeek Harness: %s\n' "$url"
}

if is_running; then
  open_ui
  exit 0
fi

mkdir -p "$state_dir"
cd "$repo"
nohup pnpm dsh web >>"$log_file" 2>&1 &
server_pid=$!

while kill -0 "$server_pid" 2>/dev/null; do
  if is_running; then
    open_ui
    exit 0
  fi
  # One second is the launch-status polling cadence, chosen for a prompt UI open
  # without generating meaningful idle load; it is not a startup deadline.
  sleep 1
done

if is_running; then
  open_ui
  exit 0
fi

printf 'DeepSeek Harness did not start. Read %s\n' "$log_file" >&2
exit 1

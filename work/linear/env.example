BRAIN_LINEAR_AUTH=client_credentials
BRAIN_LINEAR_CLIENT_ID=<app-client-id>
BRAIN_LINEAR_CLIENT_SECRET_FILE=/etc/brain-linear/app-client-secret
BRAIN_LINEAR_DECISION_TEAM_KEY=ABC
# For API-key mode instead: BRAIN_LINEAR_AUTH=api_key
# BRAIN_LINEAR_KEY_FILE=/etc/brain-linear/api-key
# BRAIN_LINEAR_VPS_KEY_FILE=/etc/brain-linear/api-key

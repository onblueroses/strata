#!/usr/bin/env python3
"""brain-linear — the pinned Linear access path for every agent runtime.

One stable contract over two transports:
  pickup <runtime>   composed /pickup query: open for:<runtime> issues + configured decision-team Deliberating
    --summary        at most three queue-health lines; excludes decision-team issues
    --full           default JSON plus description excerpt, updatedAt, and comment count
  gql <query> [vars] raw GraphQL escape hatch (admin mutations, archived reads,
                     relations+inverseRelations, puller queries); '@file' and '-'
                     accepted for both arguments
  <anything else>    passthrough to the pinned linearis CLI (day-to-day ops:
                     issues list/search/create/update/discuss/read/archive, ...)

Output is JSON except for pickup --summary's compact text. Results use stdout,
errors use stderr, and failures return non-zero. Key resolution:
$BRAIN_LINEAR_KEY_FILE, else
~/.config/linear/api_key, else $BRAIN_LINEAR_VPS_KEY_FILE (VPS).
The key never appears in argv or logs.

Opt-in app identity: BRAIN_LINEAR_AUTH=client_credentials, with
BRAIN_LINEAR_CLIENT_ID and BRAIN_LINEAR_CLIENT_SECRET_FILE (owned by this user,
mode 600). Requests default to read,write,comments:create. A mode-600 file at
<client-secret-file>.scopes containing exactly app:assignable,app:mentionable
opts that app into delegation and mentions after owner approval. All callers
of an app must use the same scope configuration: changing token scopes revokes
existing app tokens. Tokens live in memory for this invocation and are revoked
on exit; app mode never falls back to a key.

Passthrough gotchas: linearis takes comment bodies as options, never
positionals — issues discuss ABC-N --body "<text>". Failures print error-shaped
JSON, so check the exit code; parsing output truthiness misreads errors as ok.
"""

import http.client
import json
import math
import os
import re
import signal
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone

LINEARIS_PIN = "2026.7.0"

# Basis: e2e wave 2026-08-11 measured <2s per call against api.linear.app;
# 30s is 15x headroom. Override for long-running pull queries.
TIMEOUT_S = int(os.environ.get("BRAIN_LINEAR_TIMEOUT_S", "30"))

# Basis: Linear error bodies observed as small JSON (≤1KB) in the 2026-08-11
# e2e wave; 4KB preserves complete diagnostics while bounding log size.
ERR_BODY_BYTES = 4096

# Basis: Linear documents a 250-item connection cap; with cursor pagination the
# page size only affects request count, never completeness.
PAGE_SIZE = 100

# Frozen by linear-spine-hardening Decision C1.
DESCRIPTION_EXCERPT_CODEPOINTS = 400

KEY_CANDIDATES = [
    os.environ.get("BRAIN_LINEAR_KEY_FILE"),
    os.path.expanduser("~/.config/linear/api_key"),
    os.environ.get("BRAIN_LINEAR_VPS_KEY_FILE"),
]

ISSUE_PAGE_QUERY = """
query($filter: IssueFilter!, $first: Int!, $after: String) {
  issues(filter: $filter, first: $first, after: $after) {
    nodes { identifier title state { name } team { key } labels { nodes { name } } }
    pageInfo { hasNextPage endCursor }
  }
}
"""

SUMMARY_ISSUE_PAGE_QUERY = """
query($filter: IssueFilter!, $first: Int!, $after: String) {
  issues(filter: $filter, first: $first, after: $after) {
    nodes { identifier updatedAt }
    pageInfo { hasNextPage endCursor }
  }
}
"""

FULL_ISSUE_PAGE_QUERY = """
query($filter: IssueFilter!, $first: Int!, $after: String, $commentsFirst: Int!) {
  issues(filter: $filter, first: $first, after: $after) {
    nodes {
      id identifier title state { name } team { key } labels { nodes { name } }
      description updatedAt
      comments(first: $commentsFirst) {
        nodes { id }
        pageInfo { hasNextPage endCursor }
      }
    }
    pageInfo { hasNextPage endCursor }
  }
}
"""

ISSUE_COMMENTS_PAGE_QUERY = """
query($id: String!, $first: Int!, $after: String) {
  issue(id: $id) {
    comments(first: $first, after: $after) {
      nodes { id }
      pageInfo { hasNextPage endCursor }
    }
  }
}
"""

RUNTIMES = ("operator", "claude", "codex", "kimi", "ds")
DECISION_TEAM_KEY = os.environ.get("BRAIN_LINEAR_DECISION_TEAM_KEY", "ABC")
APP_SCOPES = "read,write,comments:create"
APP_INTERACTION_SCOPES = "app:assignable,app:mentionable"
OAUTH_ENDPOINT = "https://api.linear.app/oauth/"
TOKEN_RETRY_DELAYS_S = (1, 3, 9)
GQL_RETRY_DELAYS_S = (1, 3, 9)


def die(msg, code=1):
    print(json.dumps({"error": msg}), file=sys.stderr)
    sys.exit(code)


def read_key():
    for path in KEY_CANDIDATES:
        if path and os.path.isfile(path):
            key = open(path).read().strip()
            if key:
                return key
    die("no Linear API key found (BRAIN_LINEAR_KEY_FILE, ~/.config/linear/api_key, $BRAIN_LINEAR_VPS_KEY_FILE)", 2)


def read_app_scopes(secret_path):
    """Persist the opt-in per app, rather than vary token scopes by caller env."""
    try:
        fd = os.open(secret_path + ".scopes", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return APP_SCOPES
    except OSError:
        die("cannot read app scope file (symlinks are refused)", 2)
    try:
        with os.fdopen(fd) as source:
            info = os.fstat(source.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                    or stat.S_IMODE(info.st_mode) != 0o600):
                die("app scope file must be a regular file owned by this user with mode 600", 2)
            content = source.read(257)
    except (OSError, UnicodeError):
        die("cannot read app scope file (details omitted)", 2)
    if len(content) > 256 or content.strip() != APP_INTERACTION_SCOPES:
        die("app scope file must contain exactly app:assignable,app:mentionable", 2)
    return APP_SCOPES + "," + APP_INTERACTION_SCOPES


class LinearAuth:
    def __init__(self):
        mode = os.environ.get("BRAIN_LINEAR_AUTH", "api_key")
        if mode not in ("api_key", "client_credentials"):
            die("BRAIN_LINEAR_AUTH must be api_key or client_credentials", 2)
        self.app = mode == "client_credentials"
        self.key = None if self.app else read_key()
        self.access_token = None
        self.expires_at = 0
        self.issued = []
        self.secret = ""
        self.scopes = APP_SCOPES
        if self.app:
            self.client_id = os.environ.get("BRAIN_LINEAR_CLIENT_ID", "").strip()
            path = os.environ.get("BRAIN_LINEAR_CLIENT_SECRET_FILE", "")
            if not self.client_id or not path:
                die("app mode requires BRAIN_LINEAR_CLIENT_ID and BRAIN_LINEAR_CLIENT_SECRET_FILE", 2)
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd) as source:
                    info = os.fstat(source.fileno())
                    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                            or stat.S_IMODE(info.st_mode) != 0o600):
                        die("client secret must be a regular file owned by this user with mode 600", 2)
                    content = source.read(8193)
            except (OSError, UnicodeError):
                die("cannot read client secret file (symlinks are refused)", 2)
            self.secret = content.strip()
            if not self.secret or len(content) > 8192:
                die("client secret file is empty or too large", 2)
            self.scopes = read_app_scopes(path)

    def redact(self, value):
        for secret in [self.secret, *self.issued]:
            if secret:
                value = value.replace(secret, "[redacted]")
        return value

    def token(self, force=False):
        if not self.app:
            return self.key
        if not force and self.access_token and time.monotonic() < self.expires_at:
            return self.access_token
        req = urllib.request.Request(
            OAUTH_ENDPOINT + "token",
            data=urllib.parse.urlencode({
                "grant_type": "client_credentials", "client_id": self.client_id,
                "client_secret": self.secret, "scope": self.scopes,
            }).encode(),
            headers={"Content-Type": "application/x-www-form-urlencoded"},
        )
        # Minting is idempotent, so transient failures are retried: the token
        # endpoint returned 503 twice in the first hour of production use.
        for delay in TOKEN_RETRY_DELAYS_S + (None,):
            started = time.monotonic()
            try:
                with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
                    body = json.load(resp)
                break
            except urllib.error.HTTPError as e:
                e.close()  # an unclosed error object can echo its body in a ResourceWarning
                if delay is None or (e.code < 500 and e.code != 429):
                    die(f"HTTP {e.code} fetching Linear app token (response omitted)", 3)
            except (urllib.error.URLError, OSError):
                if delay is None:
                    die("cannot fetch Linear app token (details omitted)", 3)
            except ValueError:
                die("cannot parse Linear app token response (details omitted)", 3)
            time.sleep(delay)
        if not isinstance(body, dict):
            die("invalid Linear app token response", 3)
        token = body.get("access_token")
        try:
            lifetime = float(body.get("expires_in", 0))
        except (TypeError, ValueError):
            lifetime = 0
        token_type = body.get("token_type")
        if (not isinstance(token, str) or not token or any(c.isspace() for c in token)
                or not isinstance(token_type, str) or token_type.lower() != "bearer"
                or not math.isfinite(lifetime) or lifetime <= 0):
            die("invalid Linear app token response", 3)
        self.access_token = token
        self.issued.append(token)
        self.expires_at = started + lifetime - min(60, lifetime / 10)
        return token

    def authorization(self):
        token = self.token()
        return "Bearer " + token if self.app else token

    def close(self):
        # One token per CLI invocation would otherwise exhaust the app's 1000
        # active-token limit. Revoke only tokens minted by this invocation.
        for token in self.issued:
            req = urllib.request.Request(
                OAUTH_ENDPOINT + "revoke",
                data=urllib.parse.urlencode({"token": token}).encode(),
                headers={"Content-Type": "application/x-www-form-urlencoded"},
            )
            try:
                with urllib.request.urlopen(req, timeout=TIMEOUT_S):
                    pass
            except Exception as e:  # cleanup must never change the command's result
                if isinstance(e, urllib.error.HTTPError):
                    e.close()  # an unclosed error object can echo its body in a ResourceWarning
                print(json.dumps({"warning": "Linear app token cleanup failed; token expires automatically"}),
                      file=sys.stderr)
        self.issued.clear()


def read_arg(arg):
    """Support '@file' and '-' (stdin) for query/vars arguments."""
    try:
        if arg == "-":
            return sys.stdin.read()
        if arg.startswith("@"):
            return open(arg[1:]).read()
        return arg
    except OSError as e:
        die(f"cannot read argument source {arg!r}: {e}", 1)


def is_mutation(query):
    """True unless the document is plainly a query; unknown shapes count as mutations."""
    body = re.sub(r"#[^\n]*", "", query).lstrip()
    return not (body.startswith("{") or re.match(r"query\b", body))


def gql(auth, query, variables):
    # A 5xx gateway error or dropped connection is retried for reads only: a
    # mutation may already have landed, and a replay could post a comment twice.
    # Linear returned 503s that paged the alarm channel on 2026-10-08.
    retries = list(GQL_RETRY_DELAYS_S) if not is_mutation(query) else []
    refreshed = False
    while True:
        req = urllib.request.Request(
            "https://api.linear.app/graphql",
            data=json.dumps({"query": query, "variables": variables}).encode(),
            headers={"Authorization": auth.authorization(), "Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
                return json.load(resp)
        except urllib.error.HTTPError as e:
            detail = e.read(ERR_BODY_BYTES).decode(errors="replace") if not auth.app else "response omitted"
            e.close()
            if auth.app and e.code == 401 and not refreshed:
                refreshed = True
                auth.token(force=True)
                continue
            if e.code in (502, 503, 504) and retries:
                time.sleep(retries.pop(0))
                continue
            die(f"HTTP {e.code} from Linear: {detail}", 3)
        # A read timeout raises bare TimeoutError and a cut response raises
        # http.client errors, neither a URLError: the 15:00 pull on 2026-10-08
        # died on one after the retry above shipped.
        except (urllib.error.URLError, http.client.HTTPException, OSError) as e:
            if retries:
                time.sleep(retries.pop(0))
                continue
            reason = getattr(e, "reason", None) or type(e).__name__
            die("Linear app transport failure (details omitted)" if auth.app else f"transport failure: {reason}", 3)


def fetch_all_issues(auth, issue_filter, query=ISSUE_PAGE_QUERY):
    """Cursor-paginate one filtered issue connection to completeness."""
    nodes, cursor = [], None
    while True:
        variables = {"filter": issue_filter, "first": PAGE_SIZE, "after": cursor}
        if query == FULL_ISSUE_PAGE_QUERY:
            variables["commentsFirst"] = PAGE_SIZE
        body = gql(auth, query, variables)
        if body.get("errors"):
            print(auth.redact(json.dumps(body, indent=2)), file=sys.stderr)
            sys.exit(1)
        conn = body["data"]["issues"]
        nodes.extend(conn["nodes"])
        if not conn["pageInfo"]["hasNextPage"]:
            return nodes
        cursor = conn["pageInfo"]["endCursor"]


def fetch_all_full_issues(auth, issue_filter):
    """Fetch enriched issues and count every page of each comment connection."""
    issues = fetch_all_issues(auth, issue_filter, FULL_ISSUE_PAGE_QUERY)
    for issue in issues:
        comments = issue["comments"]
        count = len(comments["nodes"])
        page_info = comments["pageInfo"]
        while page_info["hasNextPage"]:
            body = gql(auth, ISSUE_COMMENTS_PAGE_QUERY, {
                "id": issue["id"],
                "first": PAGE_SIZE,
                "after": page_info["endCursor"],
            })
            if body.get("errors"):
                print(auth.redact(json.dumps(body, indent=2)), file=sys.stderr)
                sys.exit(1)
            comments = body["data"]["issue"]["comments"]
            count += len(comments["nodes"])
            page_info = comments["pageInfo"]
        issue["_commentCount"] = count
    return issues


def parse_linear_datetime(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def render_summary(runtime, issues, now=None):
    lines = [f"Open for:{runtime}: {len(issues)}"]
    if not issues:
        return lines[0]
    now = now or datetime.now(timezone.utc)
    most_stale = min(parse_linear_datetime(issue["updatedAt"]) for issue in issues)
    inactivity_days = max(0, int((now - most_stale).total_seconds() // 86400))
    recent = sorted(
        issues,
        key=lambda issue: (
            parse_linear_datetime(issue["updatedAt"]),
            issue["identifier"],
        ),
        reverse=True,
    )[:3]
    lines.extend([
        f"Most-stale inactivity: {inactivity_days}d",
        "Recently active: " + ", ".join(issue["identifier"] for issue in recent),
    ])
    return "\n".join(lines)


def description_excerpt(description):
    if description is None or len(description) <= DESCRIPTION_EXCERPT_CODEPOINTS:
        return description
    prefix = description[:DESCRIPTION_EXCERPT_CODEPOINTS]
    boundary = max(
        (index for index, character in enumerate(prefix) if character.isspace()),
        default=-1,
    )
    if boundary > 0:
        return prefix[:boundary].rstrip() + "…"
    return description[:DESCRIPTION_EXCERPT_CODEPOINTS - 1] + "…"


def render_full_issue(issue):
    rendered = {
        key: issue[key]
        for key in ("identifier", "title", "state", "team", "labels")
    }
    rendered.update({
        "descriptionExcerpt": description_excerpt(issue["description"]),
        "updatedAt": issue["updatedAt"],
        "commentCount": issue["_commentCount"],
    })
    return rendered


def render_pickup(runtime, mine, deliberating, full=False):
    if full:
        mine = [render_full_issue(issue) for issue in mine]
        deliberating = [render_full_issue(issue) for issue in deliberating]
    return json.dumps({
        "runtime": runtime,
        "issues": mine,
        "dec_deliberating": deliberating,
    }, indent=2)


def cmd_gql(auth, argv):
    if not argv:
        die("usage: brain-linear gql '<query>|@file|-' ['<vars-json>|@file|-']")
    query = read_arg(argv[0])
    if len(argv) > 1:
        try:
            variables = json.loads(read_arg(argv[1]))
        except json.JSONDecodeError as e:
            die(f"variables are not valid JSON: {e}", 1)
    else:
        variables = {}
    body = gql(auth, query, variables)
    print(auth.redact(json.dumps(body, indent=2)))
    sys.exit(1 if body.get("errors") else 0)


def cmd_pickup(auth, argv):
    if (
        not argv
        or argv[0] not in RUNTIMES
        or len(argv) > 2
        or (len(argv) == 2 and argv[1] not in ("--summary", "--full"))
    ):
        die(f"usage: brain-linear pickup <{'|'.join(RUNTIMES)}> [--summary|--full]")
    runtime = argv[0]
    mode = argv[1] if len(argv) == 2 else None
    issue_filter = {
        "labels": {"name": {"eq": f"for:{runtime}"}},
        "state": {"type": {"nin": ["completed", "canceled"]}},
    }
    if mode == "--summary":
        mine = fetch_all_issues(auth, issue_filter, SUMMARY_ISSUE_PAGE_QUERY)
        print(render_summary(runtime, mine))
        return
    fetch = fetch_all_full_issues if mode == "--full" else fetch_all_issues
    mine = fetch(auth, issue_filter)
    deliberating = fetch(auth, {
        "team": {"key": {"eq": DECISION_TEAM_KEY}},
        "state": {"name": {"eq": "Deliberating"}},
    })
    print(render_pickup(runtime, mine, deliberating, full=mode == "--full"))


def is_file_download(argv):
    """True for `files download`, global flags allowed before the command."""
    words = [a for a in argv if not a.startswith("-")]
    return words[:2] == ["files", "download"]


def cmd_passthrough(auth, argv):
    if auth.app and ("auth" in argv or any(a == "--api-token" or a.startswith("--api-token=") for a in argv)):
        die("app mode refuses token overrides and linearis auth commands", 2)
    env = dict(os.environ)
    try:
        version = subprocess.run(["linearis", "--version"], capture_output=True,
                                 text=True, env=env).stdout.strip()
    except FileNotFoundError:
        die("linearis not installed (npm install -g linearis@" + LINEARIS_PIN + "); gql/pickup still work", 4)
    if version != LINEARIS_PIN:
        if os.environ.get("BRAIN_LINEAR_ALLOW_DRIFT") == "1":
            print(f"brain-linear: WARNING linearis {version} != pinned {LINEARIS_PIN} (drift allowed by env)",
                  file=sys.stderr)
        else:
            die(f"linearis {version} != pinned {LINEARIS_PIN}; run: npm install -g linearis@{LINEARIS_PIN}, or set BRAIN_LINEAR_ALLOW_DRIFT=1 for a deliberate upgrade", 4)
    if not auth.app:
        env["LINEAR_API_TOKEN"] = auth.token()
        sys.exit(subprocess.run(["linearis", *argv], env=env).returncode)
    # The pinned CLI sends LINEAR_API_TOKEN verbatim as its GraphQL Authorization
    # header, so it needs the Bearer prefix as well as the raw GraphQL transport.
    # Buffer output so a failed first authentication attempt is not published.
    for attempt in range(2):
        # linearis' file download adds its own "Bearer " (upload does not), so
        # that one command gets the bare token.
        env["LINEAR_API_TOKEN"] = auth.token() if is_file_download(argv) else auth.authorization()
        proc = subprocess.run(["linearis", *argv], env=env, capture_output=True, text=True)
        try:
            error = json.loads(proc.stderr).get("error")
        except (ValueError, AttributeError):
            error = None
        rejected = ((proc.returncode == 42 and error == "AUTHENTICATION_REQUIRED")
                    or error == "GraphQL request failed: Request failed with status 401")
        # Only replay the worker's single-mutation commands and reads. A general
        # CLI command may have committed some work before a later request failed.
        replayable = argv[0] in ("me",) or (len(argv) > 1 and argv[:2] in (
            ["issues", "read"], ["issues", "list"], ["issues", "search"],
            ["issues", "discuss"], ["issues", "update"],
        ) and not any(a.split("=")[0] in (
            "--blocks", "--blocked-by", "--relates-to", "--duplicate-of",
            "--similar-to", "--remove-relation",
        ) for a in argv))
        if rejected and replayable and attempt == 0:
            auth.token(force=True)
            continue
        sys.stdout.write(auth.redact(proc.stdout))
        sys.stderr.write(auth.redact(proc.stderr))
        sys.exit(proc.returncode)


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    auth = LinearAuth()
    # Turn a supervisor's SIGTERM into SystemExit so the finally below revokes tokens.
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))
    try:
        if argv[0] == "gql":
            cmd_gql(auth, argv[1:])
        elif argv[0] == "pickup":
            cmd_pickup(auth, argv[1:])
        else:
            cmd_passthrough(auth, argv)
    finally:
        auth.close()


if __name__ == "__main__":
    main()

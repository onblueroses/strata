class Handler(BaseHTTPRequestHandler):
    server_version = "approve-gate"

    def log_message(self, *a):
        pass

    def allowed(self):
        host = (self.headers.get("Host") or "").lower()
        ok = self.client_address[0] in C["approvers"] and host in C["hosts"]
        if not ok:
            log(f"refused {self.command} {self.path[:60]} from={self.client_address[0]} host={host[:60]}")
            self.reply(403, {"message": "this page answers the operator's phone only"})
        elif self.path.startswith(("/general", "/api/general")):
            try:
                self.identity = phone_identity(self.client_address[0])
            except Exception:
                self.reply(403, {"message": "configured phone identity could not be verified"})
                return False
        return ok

    def reply(self, code, body, ctype="application/json"):
        raw = body.encode() if isinstance(body, str) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        if self.path.startswith("/general"):
            self.send_header("Content-Security-Policy", "default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'")
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path.startswith("/api/task-status/"):
            if (self.headers.get("Host") or "").lower() not in C["hosts"]:
                return self.reply(403, {"message": "refused"})
            try:
                task_worker(self.client_address[0])
            except Exception:
                return self.reply(403, {"message": "worker identity could not be verified"})
            try:
                return self.reply(200, task_status(self.path.removeprefix("/api/task-status/")))
            except Exception:
                return self.reply(502, {"message": "task status unavailable; stop"})
        if not self.allowed():
            return
        if self.path == "/":
            return self.reply(200, PAGE, "text/html")
        assets = {"/general": ("index.html", "text/html"), "/general/": ("index.html", "text/html"),
                  "/general/app.js": ("app.js", "application/javascript"),
                  "/general/style.css": ("style.css", "text/css")}
        if self.path in assets:
            name, ctype = assets[self.path]
            return self.reply(200, (DASHBOARD / name).read_text(), ctype)
        if self.path == "/api/general":
            try:
                return self.reply(200, general_view())
            except Exception:
                return self.reply(502, {"message": "Linear could not be checked; decisions are disabled"})
        if self.path == "/api/pending":
            try:
                return self.reply(200, {"pending": pending(), "decided": decided()})
            except Exception as e:  # noqa: BLE001
                log(f"pending failed: {e}")
                return self.reply(502, {"message": "Linear did not answer"})
        self.reply(404, {"message": "not found"})

    def do_POST(self):
        if self.path == "/api/task-close":
            try:
                if ((self.headers.get("Host") or "").lower() not in C["hosts"]
                        or self.headers.get("X-approve-gate") != "1"
                        or self.headers.get("Content-Type") != "application/json"
                        or self.headers.get("Transfer-Encoding")
                        or (self.headers.get("Origin") and not valid_origin(self.headers["Origin"]))):
                    return self.reply(403, {"message": "refused"})
                task_worker(self.client_address[0])
                length = int(self.headers.get("Content-Length") or 0)
                if not 0 < length <= 4096:
                    return self.reply(400, {"message": "invalid request size"})
                body = json.loads(self.rfile.read(length))
                code, msg = task_close(body.get("ticket"), body.get("scope_digest"), self.client_address[0])
                return self.reply(code, {"message": msg})
            except PermissionError:
                return self.reply(403, {"message": "worker identity could not be verified"})
            except Exception:
                return self.reply(502, {"message": "task completion could not be recorded; stop"})
        if not self.allowed():
            return
        origin = self.headers.get("Origin")
        # A foreign page open on the phone can fire a form at this address; it cannot set this header
        # or a JSON content type without a preflight, which is never answered.
        general = self.path in ("/api/general/decide", "/api/general/task-decide")
        if (self.path not in ("/api/decide", "/api/general/decide", "/api/general/task-decide") or self.headers.get("X-approve-gate") != "1"
                or (self.headers.get("Content-Type") or "").split(";")[0] != "application/json"
                or (origin and not valid_origin(origin)) or (general and not origin)):
            log(f"refused cross-site or malformed POST from={self.client_address[0]} origin={origin}")
            return self.reply(403, {"message": "refused"})
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if not 0 < length <= 4096 or self.headers.get("Transfer-Encoding"):
                return self.reply(400, {"message": "invalid request size"})
            body = json.loads(self.rfile.read(length))
            if not isinstance(body, dict):
                return self.reply(400, {"message": "invalid request body"})
            if self.path == "/api/general/task-decide":
                code, msg = task_decide(body.get("ticket"), body.get("scope_digest"), body.get("decision"), self.client_address[0])
            elif general:
                code, msg = general_decide(body.get("comment_id"), body.get("action_digest"), body.get("decision"), self.client_address[0])
            else:
                code, msg = decide(body.get("comment_id"), body.get("action_sha"), body.get("decision"), self.client_address[0])
        except (ValueError, TypeError):
            return self.reply(400, {"message": "invalid request body"})
        except Exception:  # noqa: BLE001
            log("decide failed; request validation or durable record write unavailable")
            code, msg = 502, "could not check the request against Linear; nothing recorded"
        self.reply(code, {"message": msg})


def load_config():
    C.clear()
    C.update(json.loads(CONFIG.read_text()))
    if not tailnet_address(C["bind"]):
        sys.exit("approve-gate: refusing a non-tailnet bind")
    if C.get("general_identity"):
        u = urlsplit(C.get("general_url", ""))
        if u.scheme not in ("http", "https") or u.netloc.lower() not in C["hosts"] or u.path != "/general" or u.query or u.fragment or u.username:
            sys.exit("approve-gate: dashboard URL must use the existing allowed origin and /general")
        if not all(C["general_identity"].get(k) for k in ("user_id", "node_id")):
            sys.exit("approve-gate: dashboard phone identity is incomplete")
    for d in (C["records"], C["state"]):
        Path(d).mkdir(parents=True, exist_ok=True)
    os.chmod(C["records"], 0o750)


def main():
    load_config()
    if C["bind"] in ("0.0.0.0", "::", ""):
        sys.exit("approve-gate: refusing to bind every interface")
    threading.Thread(target=poll_loop, daemon=True).start()
    log(f"serving on {C['bind']}:{C['port']} for {C['approvers']}")
    ThreadingHTTPServer((C["bind"], int(C["port"])), Handler).serve_forever()


if __name__ == "__main__":
    main()

# /etc/dispatcher/env  (root:dispatcher 640)
HOME=/var/lib/dispatcher
PATH=/usr/local/bin:/usr/bin:/bin
DISPATCHER_TEAM_KEY=ABC
DISPATCHER_STATE=/var/lib/dispatcher/state
DISPATCHER_EVENTS=/var/lib/linear-hook/events.jsonl
DISPATCHER_APPROVALS=/var/lib/approve-gate/records
DISPATCHER_WORKER_IDENTITIES=/etc/dispatcher/worker-identities.json
DISPATCHER_BRIEFS=/usr/local/lib/dispatcher
DISPATCHER_SSH_VPS=vps-worker
DISPATCHER_SSH_LAPTOP=laptop
DISPATCHER_CAP_VPS=2
DISPATCHER_CAP_LAPTOP=2
DISPATCHER_TIMEOUT_VPS=2700
DISPATCHER_TIMEOUT_LAPTOP=3600
# DISPATCHER_ALLOW=ABC-N   # canary mode: only these tickets are ever claimed
# Linear identity: the OAuth app "Dispatcher" (client credentials; secret file 0600, owned by dispatcher)
BRAIN_LINEAR_AUTH=client_credentials
BRAIN_LINEAR_CLIENT_ID=<client id>
BRAIN_LINEAR_CLIENT_SECRET_FILE=/var/lib/dispatcher/.config/brain/dispatcher-client-secret

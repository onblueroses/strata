# ~/.config/dispatcher/worker.env on the worker account
WORKDIR=~/work
STATE=~/.local/state/dispatcher-worker
CODEX_MODEL=gpt-6.1-sol
CODEX_EFFORT=xhigh
CODEX_SANDBOX=danger-full-access
CLAUDE_MODEL=opus
CLAUDE_CHROME=0

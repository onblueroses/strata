{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "pattern_candidates"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "disposition", "stale_findings", "underused_capabilities", "notes"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["REWRITE", "MODERNIZE", "TOUCH-UP", "CURRENT"]},
          "stale_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "category", "why_stale", "fix_direction", "ground_truth_refs"],
              "properties": {
                "quote": {"type": "string", "minLength": 1},
                "category": {"enum": ["hand-holding", "small-context", "distrust-scaffolding", "stale-facts", "old-delegation", "obsolete-workaround", "register-miscalibration"]},
                "why_stale": {"type": "string", "minLength": 1},
                "fix_direction": {"type": "string", "minLength": 1},
                "ground_truth_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "underused_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string"}
        }
      }
    },
    "pattern_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "files"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

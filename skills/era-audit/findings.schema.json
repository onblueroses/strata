{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/era-audit/findings.schema.json",
  "title": "Era audit findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "generated_at",
        "root_label",
        "corpus",
        "ground_truth",
        "runner",
        "finding_count",
        "disposition_counts",
        "category_counts"
      ],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "root_label": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "runner": {"type": "object"},
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "unknown_fields"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "unknown_fields": {"type": "array", "items": {"type": "string"}}
          }
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "captured_at",
            "git_commit",
            "git_dirty",
            "file_count",
            "bytes",
            "lines",
            "include_patterns",
            "exclude_patterns",
            "files"
          ],
          "properties": {
            "captured_at": {"type": "string", "format": "date-time"},
            "git_commit": {"type": ["string", "null"]},
            "git_dirty": {"type": ["boolean", "null"]},
            "file_count": {"type": "integer", "minimum": 1},
            "bytes": {"type": "integer", "minimum": 0},
            "lines": {"type": "integer", "minimum": 0},
            "include_patterns": {"type": "array", "items": {"type": "string"}},
            "exclude_patterns": {"type": "array", "items": {"type": "string"}},
            "batch_basis": {"type": "string", "minLength": 1},
            "files": {
              "type": "array",
              "items": {"$ref": "#/$defs/corpus_file"}
            }
          }
        },
        "finding_count": {"type": "integer", "minimum": 0},
        "disposition_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "category_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_record"}
    }
  },
  "$defs": {
    "corpus_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "bytes", "lines", "batch"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "lines": {"type": "integer", "minimum": 0},
        "batch": {"type": "integer", "minimum": 1}
      }
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "disposition",
        "stale_findings",
        "underused_capabilities",
        "notes",
        "batch"
      ],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "disposition": {
          "enum": ["REWRITE", "MODERNIZE", "TOUCH-UP", "CURRENT"]
        },
        "stale_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "underused_capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"},
        "batch": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "category", "why_stale", "fix_direction", "ground_truth_refs"],
      "properties": {
        "quote": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "hand-holding",
            "small-context",
            "distrust-scaffolding",
            "stale-facts",
            "old-delegation",
            "obsolete-workaround",
            "register-miscalibration"
          ]
        },
        "why_stale": {"type": "string", "minLength": 1},
        "fix_direction": {"type": "string", "minLength": 1},
        "ground_truth_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
